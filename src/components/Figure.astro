---
/**
 * Image with optional caption for MDX blog posts.
 * Usage:
 *   import Figure from '../../components/Figure.astro';
 *   <Figure src="/images/photo.jpg" alt="Description" caption="What you're looking at" />
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number | string;
}

const { src, alt, caption, width } = Astro.props;
---

<figure class="blog-figure">
  <img
    src={src}
    alt={alt}
    style={width ? `width: ${typeof width === 'number' ? width + 'px' : width}` : undefined}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .blog-figure {
    margin: 2.5rem 0;
    text-align: center;
  }

  .blog-figure img {
    max-width: 100%;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    display: block;
    margin: 0 auto;
  }

  .blog-figure figcaption {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    color: var(--color-muted);
    font-style: italic;
    line-height: 1.5;
  }
</style>
