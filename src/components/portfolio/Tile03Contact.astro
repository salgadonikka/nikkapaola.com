---
// Tile 03 — Contact (dark tile, full-page animation on desktop)
import { Image } from 'astro:assets';
import portfolioPhoto from '../../assets/portfolio-photo.jpg';
---

<section class="tile tile--dark" id="tile-03" data-section="03" aria-label="Contact">
  <div class="tile-inner t03c">

    <!-- Photo + identity (JS animates these in on desktop) -->
    <div class="t03c-hero" id="t03c-hero">
      <div class="t03c-photo-wrap" id="t03c-photo-wrap">
        <Image
          src={portfolioPhoto}
          alt="Nikka Paola Salgado"
          width={300}
          height={300}
          class="t03c-photo"
        />
      </div>
      <div class="t03c-identity" id="t03c-identity">
        <div class="t03c-name">Nikka Paola Salgado</div>
        <div class="t03c-role">Full-Stack Software Engineer &amp; People Manager</div>
        <div class="t03c-stack">.NET · React · Azure</div>
        <div class="t03c-avail">
          <span class="pulse-dot"></span>
          Available for new roles · Poland &amp; Europe
        </div>
      </div>
    </div>

    <!-- Heading + body copy -->
    <div class="t03c-copy" id="t03c-copy">
      <h2 class="t03c-heading">Let's work together.</h2>
      <p class="t03c-body">
        I'm actively looking for mid-level .NET full-stack roles in Poland and Europe.
        Remote or hybrid. If you're hiring, or just want to talk engineering, I'd love to hear from you.
      </p>
    </div>

    <!-- Contact links -->
    <div class="t03c-links" id="t03c-links">
      <a href="mailto:nikkapfs@gmail.com" class="t03c-link">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M1 4.5 8 9.5l7-5" stroke="currentColor" stroke-width="1.3"/>
        </svg>
        <span>nikkapfs@gmail.com</span>
      </a>
      <a href="https://linkedin.com/in/nikkasalgado" target="_blank" rel="noopener" class="t03c-link">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M3.4 5.3H1V15h2.4V5.3zM2.2 4.2a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8zM5.7 5.3V15H8V10c0-2.2 2.9-2.4 2.9 0V15H13.3V9.2c0-4.4-4.6-4.2-5.3-2.1V5.3H5.7z"/>
        </svg>
        <span>linkedin.com/in/nikkasalgado</span>
      </a>
      <a href="https://github.com/salgadonikka" target="_blank" rel="noopener" class="t03c-link">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 .5C3.86.5.5 3.86.5 8a7.5 7.5 0 0 0 5.14 7.12c.38.07.52-.16.52-.36v-1.27c-2.1.46-2.54-.9-2.54-.9-.34-.87-.84-1.1-.84-1.1-.69-.47.05-.46.05-.46.76.05 1.16.78 1.16.78.67 1.16 1.76.82 2.19.63.07-.49.26-.82.48-1.01-1.67-.19-3.43-.84-3.43-3.72 0-.82.29-1.49.78-2.02-.08-.2-.34-1 .07-2.07 0 0 .64-.2 2.09.78A7.27 7.27 0 0 1 8 4.74a7.27 7.27 0 0 1 1.9.26c1.45-.98 2.09-.78 2.09-.78.41 1.07.15 1.87.07 2.07.49.53.78 1.2.78 2.02 0 2.89-1.76 3.53-3.44 3.72.27.24.51.7.51 1.4v2.08c0 .2.14.44.52.36A7.5 7.5 0 0 0 15.5 8C15.5 3.86 12.14.5 8 .5z"/>
        </svg>
        <span>github.com/salgadonikka</span>
      </a>
      <a href="https://nikkapaola.com" class="t03c-link">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M8 1.5c-1.5 2-2.5 4-2.5 6.5s1 4.5 2.5 6.5M8 1.5c1.5 2 2.5 4 2.5 6.5S9.5 12.5 8 14.5M1.5 8h13" stroke="currentColor" stroke-width="1.3"/>
        </svg>
        <span>nikkapaola.com</span>
      </a>
      <a href="/resume.pdf" target="_blank" rel="noopener" class="t03c-link t03c-link--resume">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 2v8M5 7l3 3 3-3M2 13h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>View my Resume</span>
      </a>
    </div>

    <a href="/" class="t03c-back">← Back to nikkapaola.com</a>

  </div>
</section>
