---
import { Image } from 'astro:assets';
import myPhoto from '../../assets/myphoto.jpg';
import { siteConfig } from '../../site.config';

const { author } = siteConfig;
---

<div class="author-card">
  <Image
    src={myPhoto}
    alt={author.name}
    width={52}
    height={52}
    class="author-avatar"
  />
  <div class="author-card-body">
    <div class="author-card-name">{author.name}</div>
    <p class="author-card-bio">{author.bio}</p>
    <a href="/about" class="author-card-link">About me →</a>
  </div>
</div>

<style>
  .author-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--color-border);
    background: var(--color-warm-white);
    border-radius: 3px;
    margin-bottom: 16px;
  }

  .author-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-card-name {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--color-ink);
    font-weight: 400;
    margin-bottom: 6px;
  }

  .author-card-bio {
    font-size: 0.74rem;
    color: var(--color-muted);
    line-height: 1.65;
    font-weight: 300;
    margin-bottom: 10px;
  }

  .author-card-link {
    font-size: 0.71rem;
    color: var(--color-terracotta);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: opacity 0.15s;
  }

  .author-card-link:hover {
    opacity: 0.75;
  }
</style>
