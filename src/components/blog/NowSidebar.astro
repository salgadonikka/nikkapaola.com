---
import Icon from "../Icon.astro";
---

<div class="now-card">
  <div class="now-card-header">
    <span class="now-card-label">Right now</span>
    <a href="/now" class="now-card-more">Full /now →</a>
  </div>
  <ul class="now-card-list">
    <!--<li>
      <span class="now-card-icon"><Icon name="MapPin" size={13} weight="regular" /></span>
      <span>Cavite, Philippines - working remotely</span>
    </li>-->
    <li>
      <span class="now-card-icon"><Icon name="Leaf" size={13} weight="duotone" /></span>
      <span>Planning a big (exciting) life change</span>
    </li>
    <li>
      <span class="now-card-icon"><Icon name="Wrench" size={13} weight="duotone" /></span>
      <span>Building Tamelo + my sister's portfolio site</span>
    </li>
    <li>
      <span class="now-card-icon"><Icon name="Translate" size={13} weight="duotone" /></span>
      <span>Learning Polish & 800+ days of Spanish on Duolingo</span>
    </li>
    <li>
      <span class="now-card-icon"><Icon name="MusicNotes" size={13} weight="duotone" /></span>
      <span>Still Taylor Swift. No notes.</span>
    </li>
  </ul>
</div>

<style>
  .now-card {
    border: 1px solid var(--color-border);
    background: var(--color-warm-white);
    border-radius: 3px;
    padding: 16px;
  }

  .now-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
  }

  .now-card-label {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 500;
  }

  .now-card-more {
    font-size: 0.68rem;
    color: var(--color-terracotta);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .now-card-more:hover {
    opacity: 0.75;
  }

  .now-card-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .now-card-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.74rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    font-weight: 300;
  }

  .now-card-icon {
    display: flex;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-terracotta);
  }

  .now-card-list em {
    font-style: italic;
  }
</style>
