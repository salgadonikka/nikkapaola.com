---
import Icon from "../Icon.astro";
import { siteConfig } from "../../site.config";

const { nowTeaser } = siteConfig;
const lastUpdated = new Date(nowTeaser.lastUpdated).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<div class="now-card">
  <div class="now-card-header">
    <div class="now-card-label">
      <span class="live-dot" aria-hidden="true"></span>
      Right now
    </div>
    <a href="/now" class="now-card-more">Full /now →</a>
  </div>
  <p class="now-card-updated">Updated {lastUpdated}</p>
  <ul class="now-card-list">
    {nowTeaser.bullets.map((b) => (
      <li>
        <span class="now-card-icon"><Icon name={b.icon} size={13} weight="duotone" /></span>
        <span>{b.text}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .now-card {
    border: 1px solid var(--color-border);
    background: var(--color-warm-white);
    border-radius: 3px;
    padding: 16px;
  }

  .now-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
  }

  .now-card-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
  }

  .live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    flex-shrink: 0;
    animation: pulse-live 2s ease-in-out infinite;
  }

  @keyframes pulse-live {
    0%, 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    50%       { box-shadow: 0 0 0 4px rgba(74, 222, 128, 0); }
  }

  .now-card-more {
    font-size: 0.68rem;
    color: var(--color-terracotta);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .now-card-more:hover {
    opacity: 0.75;
  }

  .now-card-updated {
    font-size: 0.64rem;
    color: var(--color-muted);
    margin: 0 0 12px;
    letter-spacing: 0.03em;
  }

  .now-card-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .now-card-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.74rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    font-weight: 300;
  }

  .now-card-icon {
    display: flex;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-terracotta);
  }
</style>
