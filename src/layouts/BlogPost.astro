---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import AuthorCard from "../components/blog/AuthorCard.astro";
import NowSidebar from "../components/blog/NowSidebar.astro";
import ReadingProgress from "../components/blog/ReadingProgress.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import { FEATURES, siteConfig } from "../site.config";

import type { ImageMetadata } from "astro";

type Props = CollectionEntry<"blog">["data"] & {
  id?: string;
  showAuthorCard?: boolean;
  portraitImage?: ImageMetadata;
};

const {
  id,
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  portraitImage,
  category,
  tags,
  readingTime,
  showAuthorCard = true,
} = Astro.props;

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Related posts: same category or shared tags, excluding this post
const related = allPosts
  .filter((p) => {
    if (p.id === id) return false;
    const catMatch = category && p.data.category === category;
    const tagMatch = tags?.length && tags.some((t) => p.data.tags?.includes(t));
    return catMatch || tagMatch;
  })
  .slice(0, 3);

// Prev / next (sorted descending — index 0 = newest)
const currentIdx = id ? allPosts.findIndex((p) => p.id === id) : -1;
const newerPost = currentIdx > 0 ? allPosts[currentIdx - 1] : null;
const olderPost =
  currentIdx !== -1 && currentIdx < allPosts.length - 1
    ? allPosts[currentIdx + 1]
    : null;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body>
    {
      siteConfig.analytics.googleTagManagerId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${siteConfig.analytics.googleTagManagerId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <Header />
    {FEATURES.readingProgress && <ReadingProgress />}

    <main>
      {
        portraitImage ? (
          <div class="portrait-hero">
            {heroImage && (
              <Image
                src={heroImage}
                alt=""
                aria-hidden="true"
                widths={[800, 1400]}
                sizes="100vw"
                class="portrait-hero-bg"
              />
            )}
            <div class="portrait-hero-overlay" />
            <div class="portrait-hero-text">
              {category && <div class="post-category">{category}</div>}
              <h1 class="portrait-hero-title">{title}.</h1>
              {description && <p class="portrait-hero-desc">{description}</p>}
            </div>
            <div class="portrait-hero-photo">
              <Image
                src={portraitImage}
                alt={title}
                width={520}
                height={560}
                class="portrait-hero-img"
              />
            </div>
          </div>
        ) : heroImage ? (
          <div class="post-cover">
            <Image
              src={heroImage}
              alt={title}
              widths={[800, 1400]}
              sizes="100vw"
              class="post-cover-img"
            />
            <div class="post-cover-fade" />
          </div>
        ) : null
      }

      <!-- 3-column layout: TOC | article | sidebar -->
      <div
        class={`post-layout ${portraitImage ? "portrait-mode" : heroImage ? "has-cover" : "no-cover"}`}
      >
        <!-- Left: table of contents (desktop only) -->
        <aside class="post-toc-col">
          {FEATURES.tableOfContents && <TableOfContents />}
        </aside>

        <!-- Center: article -->
        <article class="post-article" data-pagefind-body>
          {
            !portraitImage && (
              <header class="post-header">
                {category && <div class="post-category">{category}</div>}

                <h1 class="post-title">{title}</h1>

                <p class="post-description">{description}</p>

                <div class="post-meta">
                  <span class="post-date">
                    <FormattedDate date={pubDate} />
                  </span>
                  {updatedDate && (
                    <span class="post-updated">
                      Updated <FormattedDate date={updatedDate} />
                    </span>
                  )}
                  {readingTime && (
                    <span class="post-reading">{readingTime}</span>
                  )}
                </div>

                {tags && tags.length > 0 && (
                  <div class="post-tags">
                    {tags.map((tag) => (
                      <a href={`/blog?tag=${tag}`} class="post-tag">
                        #{tag}
                      </a>
                    ))}
                  </div>
                )}
              </header>
            )
          }

          <div class="prose">
            <slot />
          </div>

          <footer class="post-footer">
            <!-- Prev / next navigation -->
            {
              (newerPost || olderPost) && (
                <nav class="post-nav" aria-label="Post navigation">
                  <div class="post-nav-inner">
                    {olderPost ? (
                      <a
                        href={`/blog/${olderPost.id}/`}
                        class="post-nav-link post-nav-link--prev"
                      >
                        <span class="post-nav-dir">← Older</span>
                        <span class="post-nav-title">
                          {olderPost.data.title}
                        </span>
                      </a>
                    ) : (
                      <span class="post-nav-spacer" />
                    )}
                    {newerPost ? (
                      <a
                        href={`/blog/${newerPost.id}/`}
                        class="post-nav-link post-nav-link--next"
                      >
                        <span class="post-nav-dir">Newer →</span>
                        <span class="post-nav-title">
                          {newerPost.data.title}
                        </span>
                      </a>
                    ) : (
                      <span class="post-nav-spacer" />
                    )}
                  </div>
                </nav>
              )
            }

            <a href="/blog" class="back-link">← Back to all posts</a>
          </footer>
        </article>

        <!-- Right: author card + /now overview (desktop only) -->
        <aside class="post-sidebar-col">
          {showAuthorCard && <AuthorCard />}
          <NowSidebar />
        </aside>
      </div>

      <!-- Related posts (full-width below article) -->
      {
        related.length > 0 && (
          <aside class="related-section">
            <div class="related-header">
              <h2 class="related-title">You might also like</h2>
              <div class="related-line" />
            </div>
            <div class="related-grid">
              {related.map((post) => (
                <a href={`/blog/${post.id}/`} class="related-card">
                  <div class="related-image">
                    {post.data.heroImage ? (
                      <Image
                        src={post.data.heroImage}
                        alt={post.data.title}
                        width={400}
                        height={240}
                        class="related-img"
                      />
                    ) : (
                      <span class="related-placeholder">✦</span>
                    )}
                  </div>
                  <div class="related-body">
                    {post.data.category && (
                      <div class="related-cat">{post.data.category}</div>
                    )}
                    <h3 class="related-card-title">{post.data.title}</h3>
                    <p class="related-date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </aside>
        )
      }
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    background: var(--color-cream);
  }

  /* ── COVER IMAGE ── */
  .post-cover {
    position: relative;
    width: 100%;
    height: 55vh;
    min-height: 320px;
    overflow: hidden;
    margin-top: 64px; /* nav height */
  }

  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .post-cover-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(
      to top,
      var(--color-cream) 0%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ── 3-COLUMN LAYOUT ── */
  .post-layout {
    padding: 0 24px;
    margin: 0 auto;
    max-width: 768px; /* article-only on small screens */
  }

  /* No-cover: push everything below nav */
  .post-layout.no-cover {
    padding-top: 120px;
  }

  /* Has-cover: overlap the fade */
  .post-layout.has-cover {
    margin-top: -60px;
    position: relative;
    z-index: 1;
  }

  /* Hide sidebars by default (mobile / narrow) */
  .post-toc-col,
  .post-sidebar-col {
    display: none;
  }

  /* ── Right sidebar visible at 1100px+ ── */
  @media (min-width: 1100px) {
    .post-layout {
      display: grid;
      grid-template-columns: minmax(0, 720px) 200px;
      grid-template-areas: "article sidebar";
      column-gap: 48px;
      max-width: calc(720px + 48px + 200px + 48px);
      padding-left: 24px;
      padding-right: 24px;
    }

    .post-article {
      grid-area: article;
    }

    .post-sidebar-col {
      display: block;
      grid-area: sidebar;
      position: sticky;
      top: 100px;
      align-self: start;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      /* hide scrollbar */
      scrollbar-width: none;
    }

    .post-sidebar-col::-webkit-scrollbar {
      display: none;
    }
  }

  /* ── Left TOC also visible at 1380px+ ── */
  @media (min-width: 1380px) {
    .post-layout {
      grid-template-columns: 200px minmax(0, 720px) 200px;
      grid-template-areas: "toc article sidebar";
      column-gap: 48px;
      max-width: calc(200px + 48px + 720px + 48px + 200px + 48px);
    }

    .post-toc-col {
      display: block;
      grid-area: toc;
      position: sticky;
      top: 100px;
      align-self: start;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      scrollbar-width: none;
    }

    .post-toc-col::-webkit-scrollbar {
      display: none;
    }
  }

  /* ── ARTICLE ── */
  .post-article {
    padding-bottom: 100px;
    min-width: 0; /* prevent grid blowout */
  }

  /* ── HEADER ── */
  .post-header {
    margin-bottom: 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
  }

  /* ── PORTRAIT HERO ── */
  .portrait-hero {
    position: relative;
    display: flex;
    align-items: stretch;
    width: 100%;
    margin-top: 64px;
    min-height: 440px;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .portrait-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    z-index: 0;
  }

  /* Fades the background from cream on the left (legible text) to transparent on the right (hero shows through portrait) */
  .portrait-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      #faf7f2 0%,
      #faf7f2 30%,
      rgba(250, 247, 242, 0.6) 55%,
      rgba(250, 247, 242, 0) 75%
    );
    z-index: 1;
  }

  .portrait-hero-text {
    position: relative;
    z-index: 2;
    flex: 1;
    padding: 72px 56px 72px 10%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .portrait-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 20px;
  }

  .portrait-hero-desc {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 380px;
  }

  .portrait-hero-photo {
    position: relative;
    z-index: 2;
    flex: 0 0 40%;
    overflow: hidden;
    align-self: stretch;
  }

  .portrait-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .post-layout.portrait-mode {
    padding-top: 60px;
  }

  @media (max-width: 640px) {
    .portrait-hero {
      flex-direction: column;
      padding: 0;
      min-height: unset;
    }

    .portrait-hero-photo {
      flex: none;
      height: 300px;
      width: 100%;
    }

    .portrait-hero-text {
      padding: 40px 24px 48px;
    }

    .portrait-hero-overlay {
      background: linear-gradient(
        to bottom,
        rgba(250, 247, 242, 0) 0%,
        #faf7f2 60%
      );
    }

    .post-layout.portrait-mode {
      padding-top: 40px;
    }
  }

  .post-category {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .post-category::before {
    content: "";
    display: inline-block;
    width: 20px;
    height: 1px;
    background: var(--color-terracotta);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-ink);
    margin-bottom: 20px;
  }

  .post-description {
    font-size: 1.05rem;
    color: var(--color-muted);
    font-weight: 300;
    line-height: 1.7;
    margin-bottom: 24px;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .post-meta {
    display: flex;
    gap: 20px;
    align-items: center;
    font-size: 0.8rem;
    color: var(--color-muted);
    flex-wrap: wrap;
  }

  .post-updated,
  .post-reading {
    position: relative;
    padding-left: 20px;
  }

  .post-updated::before,
  .post-reading::before {
    content: "·";
    position: absolute;
    left: 4px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .post-tag {
    font-size: 0.72rem;
    color: var(--color-muted);
    background: var(--color-warm-white);
    border: 1px solid var(--color-border);
    padding: 4px 12px;
    border-radius: 20px;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .post-tag:hover {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta);
  }

  /* ── FOOTER ── */
  .post-footer {
    margin-top: 60px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* ── PREV / NEXT ── */
  .post-nav-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: var(--color-warm-white);
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .post-nav-link:hover {
    border-color: var(--color-terracotta);
    background: var(--color-cream);
  }

  .post-nav-link--next {
    text-align: right;
  }

  .post-nav-dir {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
  }

  .post-nav-title {
    font-size: 0.82rem;
    color: var(--color-ink);
    line-height: 1.4;
    font-family: var(--font-serif);
  }

  .post-nav-spacer {
    display: block;
  }

  .back-link {
    font-size: 0.82rem;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
    align-self: flex-start;
  }

  .back-link:hover {
    color: var(--color-terracotta);
  }

  /* ── RELATED POSTS ── */
  .related-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 72px 60px 100px;
    border-top: 1px solid var(--color-border);
  }

  .related-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 36px;
  }

  .related-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .related-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .related-card {
    background: var(--color-cream);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: background 0.2s;
  }

  .related-card:hover {
    background: var(--color-warm-white);
  }

  .related-image {
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, #e8d5ce 0%, #d4c4ba 60%, #c8b8ae 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .related-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .related-card:hover .related-img {
    transform: scale(1.04);
  }
  .related-placeholder {
    color: rgba(80, 60, 50, 0.2);
    font-size: 1.5rem;
  }

  .related-body {
    padding: 20px 22px 24px;
  }

  .related-cat {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .related-card-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.35;
    margin-bottom: 8px;
    transition: color 0.2s;
  }

  .related-card:hover .related-card-title {
    color: var(--color-terracotta);
  }
  .related-date {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .post-layout {
      padding: 0 20px;
    }
    .post-layout.no-cover {
      padding-top: 100px;
    }
    .related-section {
      padding: 60px 24px 80px;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
    .post-nav-inner {
      grid-template-columns: 1fr;
    }
    .post-nav-link--next {
      text-align: left;
    }
  }
</style>
