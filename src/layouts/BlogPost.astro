---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { id, title, description, pubDate, updatedDate, heroImage, category, tags, readingTime } =
  Astro.props;

// Related posts: same category or shared tags, excluding this post
const related = (await getCollection('blog'))
  .filter((p) => {
    if (p.id === id) return false;
    const catMatch = category && p.data.category === category;
    const tagMatch = tags?.length && tags.some((t) => p.data.tags?.includes(t));
    return catMatch || tagMatch;
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body>
    <Header />

    <main>
      <!-- Hero / cover -->
      {heroImage && (
        <div class="post-cover">
          <Image
            src={heroImage}
            alt={title}
            widths={[800, 1400]}
            sizes="100vw"
            class="post-cover-img"
          />
          <div class="post-cover-fade"></div>
        </div>
      )}

      <article class={`post-article ${heroImage ? 'has-cover' : 'no-cover'}`} data-pagefind-body>
        <header class="post-header">
          {category && <div class="post-category">{category}</div>}

          <h1 class="post-title">{title}</h1>

          <p class="post-description">{description}</p>

          <div class="post-meta">
            <span class="post-date">
              <FormattedDate date={pubDate} />
            </span>
            {updatedDate && (
              <span class="post-updated">
                Updated <FormattedDate date={updatedDate} />
              </span>
            )}
            {readingTime && <span class="post-reading">{readingTime}</span>}
          </div>

          {tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => (
                <a href={`/blog?tag=${tag}`} class="post-tag">#{tag}</a>
              ))}
            </div>
          )}
        </header>

        <div class="prose">
          <slot />
        </div>

        <footer class="post-footer">
          <a href="/blog" class="back-link">← Back to all posts</a>
        </footer>
      </article>

      {related.length > 0 && (
        <aside class="related-section">
          <div class="related-header">
            <h2 class="related-title">You might also like</h2>
            <div class="related-line"></div>
          </div>
          <div class="related-grid">
            {related.map((post) => (
              <a href={`/blog/${post.id}/`} class="related-card">
                <div class="related-image">
                  {post.data.heroImage ? (
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      width={400}
                      height={240}
                      class="related-img"
                    />
                  ) : (
                    <span class="related-placeholder">✦</span>
                  )}
                </div>
                <div class="related-body">
                  {post.data.category && <div class="related-cat">{post.data.category}</div>}
                  <h3 class="related-card-title">{post.data.title}</h3>
                  <p class="related-date"><FormattedDate date={post.data.pubDate} /></p>
                </div>
              </a>
            ))}
          </div>
        </aside>
      )}
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    background: var(--color-cream);
  }

  /* ── COVER IMAGE ── */
  .post-cover {
    position: relative;
    width: 100%;
    height: 55vh;
    min-height: 320px;
    overflow: hidden;
    margin-top: 64px; /* nav height */
  }

  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .post-cover-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 60%;
    background: linear-gradient(to top, var(--color-cream) 0%, transparent 100%);
    pointer-events: none;
  }

  /* ── ARTICLE ── */
  .post-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px 100px;
  }

  .post-article.no-cover {
    padding-top: 120px;
  }

  .post-article.has-cover {
    padding-top: 0;
    margin-top: -60px;
    position: relative;
    z-index: 1;
  }

  /* ── HEADER ── */
  .post-header {
    margin-bottom: 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
  }

  .post-category {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .post-category::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background: var(--color-terracotta);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-ink);
    margin-bottom: 20px;
  }

  .post-description {
    font-size: 1.05rem;
    color: var(--color-muted);
    font-weight: 300;
    line-height: 1.7;
    margin-bottom: 24px;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .post-meta {
    display: flex;
    gap: 20px;
    align-items: center;
    font-size: 0.8rem;
    color: var(--color-muted);
    flex-wrap: wrap;
  }

  .post-updated, .post-reading {
    position: relative;
    padding-left: 20px;
  }

  .post-updated::before, .post-reading::before {
    content: '·';
    position: absolute;
    left: 4px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .post-tag {
    font-size: 0.72rem;
    color: var(--color-muted);
    background: var(--color-warm-white);
    border: 1px solid var(--color-border);
    padding: 4px 12px;
    border-radius: 20px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .post-tag:hover {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta);
  }

  /* ── FOOTER ── */
  .post-footer {
    margin-top: 60px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.82rem;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--color-terracotta); }

  /* ── RELATED POSTS ── */
  .related-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 72px 60px 100px;
    border-top: 1px solid var(--color-border);
  }

  .related-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 36px;
  }

  .related-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .related-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .related-card {
    background: var(--color-cream);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: background 0.2s;
  }

  .related-card:hover { background: var(--color-warm-white); }

  .related-image {
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, #e8d5ce 0%, #d4c4ba 60%, #c8b8ae 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .related-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .related-card:hover .related-img { transform: scale(1.04); }
  .related-placeholder { color: rgba(80,60,50,0.2); font-size: 1.5rem; }

  .related-body { padding: 20px 22px 24px; }

  .related-cat {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .related-card-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.35;
    margin-bottom: 8px;
    transition: color 0.2s;
  }

  .related-card:hover .related-card-title { color: var(--color-terracotta); }
  .related-date { font-size: 0.72rem; color: var(--color-muted); }

  @media (max-width: 768px) {
    .related-section { padding: 60px 24px 80px; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
