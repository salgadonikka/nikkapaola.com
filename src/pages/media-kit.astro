---
import { FEATURES, siteConfig } from "../site.config";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

if (!FEATURES.mediaKit) {
  return Astro.redirect("/");
}

// TODO: Build out the media kit page.
// Suggested sections:
//   - Hero: name, tagline, headshot
//   - Audience stats: follower counts per platform, monthly readers
//   - Past collaborations: brand logos + brief descriptions
//   - Content pillars: topics you cover
//   - Rate card or "contact me" CTA
//   - Downloadable press kit PDF link
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Media Kit - ${siteConfig.title}`}
      description={`Press and collaboration info for ${siteConfig.author.name}.`}
    />
  </head>
  <body>
    <Header />
    <main>
      <h1>Media Kit — coming soon</h1>
    </main>
    <Footer />
  </body>
</html>
