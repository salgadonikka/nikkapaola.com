---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import Icon from "../../components/Icon.astro";
import { SITE_TITLE } from "../../consts";
import { siteConfig } from "../../site.config";

// Static site: query params are not available at build time.
// All filtering is handled client-side via the <script> block below.
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `Blog - ${SITE_TITLE}`;

const topics = siteConfig.topics;

// Collect all tags across all posts for the tag cloud
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags ?? []))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description="All posts from nikkapaola.com" />
  </head>
  <body>
    <Header />

    <main>
      <div class="blog-layout">
        <!-- ── LEFT: POST LIST ── -->
        <div class="post-list-col">
          <div class="page-header">
            <div class="page-eyebrow">All posts</div>
            <h1 class="page-title">The <em>blog</em></h1>

            <!-- shown/populated by client-side filter script -->
            <div id="filter-bar" class="filter-bar" style="display:none">
              <span class="filter-label">Filtering by</span>
              <span class="filter-chip">
                <span id="filter-chip-value"></span>
                <a
                  href="/blog"
                  class="filter-chip-remove"
                  aria-label="Remove filter">✕</a
                >
              </span>
              <span id="filter-count" class="filter-count"></span>
            </div>
          </div>

          <div id="empty-state" class="empty-state" style="display:none">
            <p>
              No posts match that filter. <a
                href="/blog"
                style="color:var(--color-terracotta)">Clear filter</a>
            </p>
          </div>

          {
            allPosts.length === 0 ? (
              <div class="empty-state">
                <p>No posts here yet. Check back soon ✦</p>
              </div>
            ) : (
              <ul class="post-list">
                {allPosts.map((post) => (
                  <li
                    class="post-row"
                    data-cat={post.data.category?.toLowerCase() ?? ""}
                    data-tags={(post.data.tags ?? []).join(",")}
                  >
                    <a href={`/blog/${post.id}/`} class="post-row-link">
                      <div class="post-row-body">
                        <div class="post-row-meta-top">
                          {post.data.category && (
                            <span class="post-row-cat">
                              {post.data.category}
                            </span>
                          )}
                          {post.data.isAlbum && (
                            <span class="post-row-album">📷 Album</span>
                          )}
                        </div>

                        <h2 class="post-row-title">{post.data.title}</h2>
                        <p class="post-row-desc">{post.data.description}</p>

                        <div class="post-row-meta-bottom">
                          <span class="post-row-date">
                            <FormattedDate date={post.data.pubDate} />
                          </span>
                          {post.data.readingTime && (
                            <span class="post-row-reading">
                              · {post.data.readingTime}
                            </span>
                          )}
                          {post.data.tags && post.data.tags.length > 0 && (
                            <span class="post-row-tags">
                              {post.data.tags.slice(0, 3).map((tag) => (
                                <span class="post-row-tag">#{tag}</span>
                              ))}
                            </span>
                          )}
                        </div>
                      </div>

                      {post.data.heroImage && (
                        <div class="post-row-thumb">
                          <Image
                            src={post.data.heroImage}
                            alt={post.data.title}
                            width={160}
                            height={120}
                            class="post-row-thumb-img"
                          />
                        </div>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <!-- ── RIGHT: SIDEBAR ── -->
        <aside class="sidebar">
          <div class="sidebar-section">
            <h3 class="sidebar-heading">Browse by topic</h3>
            <ul class="topic-list">
              {
                topics.map((t) => (
                  <li>
                    <a href={`/blog?cat=${t.cat}`} class="topic-link">
                      <span class="topic-icon"><Icon name={t.icon} size={15} weight="duotone" /></span>
                      <span class="topic-name">{t.name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            allTags.length > 0 && (
              <div class="sidebar-section">
                <h3 class="sidebar-heading">Tags</h3>
                <div class="tag-cloud">
                  {allTags.map((tag) => (
                    <a href={`/blog?tag=${tag}`} class="tag-pill">
                      #{tag}
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <div class="sidebar-section">
            <a href="/search" class="sidebar-search">
              <svg
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  cx="6.5"
                  cy="6.5"
                  r="5"
                  stroke="currentColor"
                  stroke-width="1.4"></circle>
                <line
                  x1="10.5"
                  y1="10.5"
                  x2="14.5"
                  y2="14.5"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"></line>
              </svg>
              Search all posts
            </a>
          </div>
        </aside>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 120px 60px 100px;
  }

  /* ── TWO-COLUMN LAYOUT ── */
  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 72px;
    align-items: start;
  }

  /* ── PAGE HEADER ── */
  .page-header {
    margin-bottom: 48px;
  }

  .page-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .page-eyebrow::before {
    content: "";
    display: inline-block;
    width: 20px;
    height: 1px;
    background: var(--color-terracotta);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.1;
  }

  .page-title em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  /* ── ACTIVE FILTER BAR ── */
  .filter-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.78rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-blossom);
    color: var(--color-terracotta);
    border: 1px solid var(--color-blossom-deep);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .filter-chip-remove {
    color: var(--color-terracotta);
    text-decoration: none;
    font-size: 0.7rem;
    opacity: 0.7;
    transition: opacity 0.2s;
    line-height: 1;
  }

  .filter-chip-remove:hover {
    opacity: 1;
  }

  .filter-count {
    font-size: 0.72rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  /* ── POST LIST ── */
  .post-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .post-row {
    border-bottom: 1px solid var(--color-border);
  }

  .post-row-link {
    display: flex;
    align-items: flex-start;
    gap: 28px;
    padding: 28px 0;
    text-decoration: none;
    transition: background 0.2s;
  }

  .post-row-link:hover .post-row-title {
    color: var(--color-terracotta);
  }

  /* body takes all space; thumb is fixed-width */
  .post-row-body {
    flex: 1;
    min-width: 0;
  }

  /* top meta: category + album badge */
  .post-row-meta-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .post-row-cat {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-terracotta);
    font-weight: 500;
  }

  .post-row-album {
    font-size: 0.68rem;
    color: var(--color-muted);
    background: var(--color-warm-white);
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: 20px;
  }

  .post-row-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.3;
    margin-bottom: 8px;
    transition: color 0.2s;
  }

  .post-row-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.7;
    font-weight: 300;
    margin-bottom: 12px;
    /* clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-row-meta-bottom {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .post-row-reading {
    color: var(--color-muted);
  }

  .post-row-tags {
    display: flex;
    gap: 6px;
    margin-left: 4px;
  }

  .post-row-tag {
    color: var(--color-muted);
    background: var(--color-warm-white);
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 0.68rem;
  }

  /* optional thumbnail */
  .post-row-thumb {
    flex-shrink: 0;
    width: 120px;
    height: 88px;
    border-radius: 4px;
    overflow: hidden;
    background: linear-gradient(135deg, #e8d5ce 0%, #d4c4ba 60%, #c8b8ae 100%);
  }

  .post-row-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .post-row-link:hover .post-row-thumb-img {
    transform: scale(1.05);
  }

  /* ── EMPTY STATE ── */
  .empty-state {
    padding: 80px 0;
    text-align: center;
    border-top: 1px solid var(--color-border);
  }
  .empty-state p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  /* ── SIDEBAR ── */
  .sidebar {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-heading {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    font-weight: 500;
  }

  /* topic list */
  .topic-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-ink-soft);
    font-size: 0.84rem;
    font-weight: 300;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .topic-link:hover {
    background: var(--color-warm-white);
    color: var(--color-terracotta);
  }

  .topic-link--active {
    background: var(--color-blossom);
    color: var(--color-terracotta);
    font-weight: 400;
  }

  .topic-icon {
    display: flex;
    flex-shrink: 0;
    color: var(--color-terracotta);
  }
  .topic-name {
    flex: 1;
  }

  /* tag cloud */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-pill {
    font-size: 0.72rem;
    color: var(--color-muted);
    background: var(--color-warm-white);
    border: 1px solid var(--color-border);
    padding: 4px 10px;
    border-radius: 20px;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .tag-pill:hover {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta);
  }

  .tag-pill--active {
    background: var(--color-blossom);
    color: var(--color-terracotta);
    border-color: var(--color-blossom-deep);
  }

  /* search link */
  .sidebar-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .sidebar-search:hover {
    color: var(--color-terracotta);
    border-color: var(--color-terracotta);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .blog-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px;
      border-top: 1px solid var(--color-border);
      padding-top: 24px;
      margin-top: 8px;
    }

    .sidebar-section {
      min-width: 180px;
      flex: 1;
    }

    .topic-list {
      gap: 0;
    }
    .topic-link {
      padding: 6px 8px;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 600px) {
    main {
      padding: 100px 24px 80px;
    }

    .post-row-thumb {
      width: 88px;
      height: 66px;
    }
    .post-row-title {
      font-size: 1.1rem;
    }

    .sidebar {
      flex-direction: column;
    }
    .sidebar-section {
      min-width: unset;
    }
  }
</style>

<script>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get("cat") || "";
    const tag = params.get("tag") || "";
    if (!cat && !tag) return;

    // --- filter post rows ---
    const rows = document.querySelectorAll<HTMLElement>(".post-row");
    let visible = 0;
    rows.forEach((row) => {
      const rowCat = row.dataset.cat || "";
      const rowTags = row.dataset.tags ? row.dataset.tags.split(",") : [];
      const match = cat ? rowCat === cat.toLowerCase() : rowTags.includes(tag);
      if (match) {
        visible++;
      } else {
        row.style.display = "none";
      }
    });

    // --- filter bar ---
    const bar = document.getElementById("filter-bar");
    const chipValue = document.getElementById("filter-chip-value");
    const countEl = document.getElementById("filter-count");
    if (bar) bar.style.display = "flex";
    if (chipValue) chipValue.textContent = cat ? cat : `#${tag}`;
    if (countEl)
      countEl.textContent = `${visible} post${visible !== 1 ? "s" : ""}`;

    // --- empty state ---
    if (visible === 0) {
      const list = document.querySelector<HTMLElement>(".post-list");
      const empty = document.getElementById("empty-state");
      if (list) list.style.display = "none";
      if (empty) empty.style.display = "block";
    }

    // --- active topic link ---
    document
      .querySelectorAll<HTMLAnchorElement>(".topic-link")
      .forEach((link) => {
        const lp = new URLSearchParams(
          (link.getAttribute("href") || "").split("?")[1] || "",
        );
        if (cat && lp.get("cat") === cat)
          link.classList.add("topic-link--active");
      });

    // --- active tag pill ---
    document
      .querySelectorAll<HTMLAnchorElement>(".tag-pill")
      .forEach((pill) => {
        const lp = new URLSearchParams(
          (pill.getAttribute("href") || "").split("?")[1] || "",
        );
        if (tag && lp.get("tag") === tag)
          pill.classList.add("tag-pill--active");
      });
  })();
</script>
