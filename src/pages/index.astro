---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NewsletterForm from '../components/NewsletterForm.tsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import myPhoto from '../assets/myphoto.jpg';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const [featuredPost, ...sidebarPosts] = recentPosts;

const topics = [
  { icon: '🌸', name: 'Life & Self', desc: 'Reflections, routines, and some life nuggets.', count: 'Personal · Journal', color: 'terracotta', cat: 'life' },
  { icon: '🎗️', name: 'Health Journey', desc: 'Thyroid cancer, recovery, and what comes after.', count: 'Health · Survival', color: 'dusty-rose', cat: 'health' },
  { icon: '🗺️', name: 'Travel', desc: 'Places I\'ve been, things I\'ve learned there.', count: 'Travel · Photography', color: 'gold', cat: 'travel' },
  { icon: '🌙', name: 'A New Chapter', desc: 'Something is taking shape. I\'ll tell you when it\'s time.', count: 'Coming Soon · TBA', color: 'sage', cat: 'tba' },
  { icon: '💻', name: 'Software Dev', desc: 'Building things, career lessons, and tech thoughts.', count: 'Tech · Career', color: 'terracotta', cat: 'work' },
  { icon: '📊', name: 'Personal Finance', desc: 'Budgeting, saving, and making money less scary.', count: 'Finance · Org', color: 'blue', cat: 'finance' },
  { icon: '✨', name: 'Hobbies & Misc', desc: 'Everything else that doesn\'t fit a neat box.', count: 'Lifestyle · Random', color: 'lavender', cat: 'misc' },
  { icon: '📖', name: 'Learnings', desc: 'Books, courses, and things I\'m figuring out.', count: 'Growth · Notes', color: 'sage', cat: 'learnings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <!-- ── HERO ── -->
    <section class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">Personal blog &amp; a little corner of the internet</div>
        <h1 class="hero-title">
          Nothing on pause.<br />
          <em>Everything on purpose.</em>
        </h1>
        <p class="hero-tagline">A documentation of my life.</p>
        {/* <p class="hero-bio">
          Hi, I'm Nikka. A software developer, thyroid cancer survivor, a traveler.
          I'm here to share the things I'm learning, the things I want to remember,
          and everything else in between.
        </p> */}
        <div class="hero-tags">
          <span class="tag tag-rose">Health</span>
          <!--<span class="tag tag-sage">Moving to Poland</span>-->
          <span class="tag tag-gold">Travel</span>
          <span class="tag tag-blue">Software Development</span>
          <span class="tag tag-lavender">Finance</span>
        </div>
        <div class="hero-cta">
          <a href="#posts" class="btn-primary">Read the blog</a>
          <a href="/about" class="btn-ghost">About me</a>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-image-area">
          <Image
            src={myPhoto}
            alt="Nikka Paola"
            class="hero-photo"
            widths={[800, 1200]}
            sizes="50vw"
          />
          <div class="hero-photo-fade"></div>

          <div class="floating-card card-location">
            <div class="card-label">📍 Currently in</div>
            <div class="card-value">Philippines</div>
          </div>

          <div class="floating-card card-season">
            <div class="card-label">🌱 Next chapter</div>
            <div class="card-value">Something exciting, TBA</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── TOPICS ── -->
    <section class="topics-section">
      <div class="section-header">
        <h2 class="section-title">What I write <em>about</em></h2>
        <div class="section-line"></div>
      </div>
      <div class="topics-grid">
        {topics.map((t) => (
          <a href={`/blog?cat=${t.cat}`} class={`topic-card tc-${t.color}`}>
            <span class="topic-icon">{t.icon}</span>
            <div class="topic-name">{t.name}</div>
            <div class="topic-desc">{t.desc}</div>
            <span class="topic-count">{t.count}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ── RECENT POSTS ── -->
    <!--<section class="posts-section" id="posts">
      <div class="section-header">
        <h2 class="section-title">Recent <em>posts</em></h2>
        <div class="section-line"></div>
      </div>

      {recentPosts.length === 0 ? (
        <p class="no-posts">Posts coming soon. Stay tuned ✦</p>
      ) : (
        <div class="posts-layout">
          {featuredPost && (
            <a href={`/blog/${featuredPost.id}/`} class="featured-post">
              <div class="featured-image">
                {featuredPost.data.heroImage ? (
                  <Image
                    src={featuredPost.data.heroImage}
                    alt={featuredPost.data.title}
                    width={800}
                    height={450}
                    class="featured-image-img"
                  />
                ) : (
                  <span class="featured-image-text">✦</span>
                )}
              </div>
              <div class="featured-category">{featuredPost.data.category ?? 'Journal'}</div>
              <h3 class="featured-title">{featuredPost.data.title}</h3>
              <p class="featured-excerpt">{featuredPost.data.description}</p>
              <div class="post-meta">
                <span><FormattedDate date={featuredPost.data.pubDate} /></span>
                {featuredPost.data.readingTime && <span>{featuredPost.data.readingTime}</span>}
              </div>
            </a>
          )}

          {sidebarPosts.length > 0 && (
            <aside class="posts-sidebar">
              <h3>More recent</h3>
              {sidebarPosts.map((post) => (
                <a href={`/blog/${post.id}/`} class="post-list-item">
                  <div class="post-list-cat">{post.data.category ?? 'Journal'}</div>
                  <div class="post-list-title">{post.data.title}</div>
                  <div class="post-list-date">
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.readingTime && <> · {post.data.readingTime}</>}
                  </div>
                </a>
              ))}
            </aside>
          )}
        </div>
      )}

      <div class="view-all-wrap">
        <a href="/blog" class="btn-primary">View all posts</a>
      </div>
    </section>-->

    <!-- ── ABOUT STRIP ── -->
    <section class="about-strip" id="about">
      <div class="about-text">
        <h2>A little about <em>who I am</em></h2>
        <p>
          I'm Nikka, a Filipino software developer with a lot going on. This blog is where I write
          about the things I want to remember and the things I think might help someone else. I'm
          trying to live life intentionally and I want to put out something positive into the world. 
          Cancer, code, money, travel, and the slow work of building a life that actually fits.
        </p>
        <a href="/about" class="about-link">Read the full story</a>
      </div>
      <div class="about-facts">
        <div class="fact">
          <span class="fact-emoji">🇵🇭</span>
          <div class="fact-label">Based in</div>
          <div class="fact-value">Manila, Philippines</div>
        </div>
        <div class="fact">
          <span class="fact-emoji">🌱</span>
          <div class="fact-label">Next chapter</div>
          <div class="fact-value">A big move, soon</div>
        </div>
        <div class="fact">
          <span class="fact-emoji">💼</span>
          <div class="fact-label">By day</div>
          <div class="fact-value">Software Developer</div>
        </div>
        <div class="fact">
          <span class="fact-emoji">✈️</span>
          <div class="fact-label">Countries visited</div>
          <div class="fact-value">Still counting...</div>
        </div>
      </div>
    </section>

    <!-- ── NEWSLETTER ── -->
    <!--
    <section class="newsletter-section">
      <h2>Stay in the loop</h2>
      <p>New posts when I have something worth saying — no filler, no spam. Just the good stuff.</p>
      <NewsletterForm client:load />
      <p class="newsletter-note">No spam. Unsubscribe anytime. ✦</p>
    </section>
    -->
    <Footer />
  </body>
</html>

<style>
  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 80px;
    overflow: hidden;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse at 80% 20%, rgba(245,221,232,0.35) 0%, transparent 55%),
      radial-gradient(ellipse at 10% 80%, rgba(212,228,217,0.25) 0%, transparent 45%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 60px;
    animation: fadeUp 1s ease 0.2s both;
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--color-terracotta);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 4.8vw, 4.2rem);
    line-height: 1.12;
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .hero-title em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-muted);
    margin-bottom: 20px;
  }

  .hero-bio {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--color-ink-soft);
    max-width: 440px;
    margin-bottom: 32px;
    font-weight: 300;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }

  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .tag-rose     { background: #f2e4e1; color: #a0514a; }
  .tag-sage     { background: var(--color-sage-light); color: #3d6b4f; }
  .tag-gold     { background: #f0e8d8; color: #7a5c2a; }
  .tag-blue     { background: #dfe8f0; color: #3a5a78; }
  .tag-lavender { background: #ece8f5; color: #5a4a80; }
  .tag-blossom  { background: var(--color-blossom); color: #9a4870; }

  :global(html[data-theme="dark"]) .tag-rose     { background: #3d2220; color: #e8a090; }
  :global(html[data-theme="dark"]) .tag-sage     { color: #7dba96; }
  :global(html[data-theme="dark"]) .tag-gold     { background: #2e2416; color: #d4a85c; }
  :global(html[data-theme="dark"]) .tag-blue     { background: #1a2535; color: #7aafd4; }
  :global(html[data-theme="dark"]) .tag-lavender { background: #221a35; color: #a090d4; }
  :global(html[data-theme="dark"]) .tag-blossom  { color: #d47aaa; }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .tag-rose     { background: #3d2220; color: #e8a090; }
    :global(html:not([data-theme="light"])) .tag-sage     { color: #7dba96; }
    :global(html:not([data-theme="light"])) .tag-gold     { background: #2e2416; color: #d4a85c; }
    :global(html:not([data-theme="light"])) .tag-blue     { background: #1a2535; color: #7aafd4; }
    :global(html:not([data-theme="light"])) .tag-lavender { background: #221a35; color: #a090d4; }
    :global(html:not([data-theme="light"])) .tag-blossom  { color: #d47aaa; }
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .btn-primary {
    background: var(--color-terracotta);
    color: white;
    padding: 13px 28px;
    border-radius: 3px;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    display: inline-block;
  }

  .btn-primary:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-1px);
  }

  .btn-ghost {
    color: var(--color-ink-soft);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }

  .btn-ghost:hover { color: var(--color-terracotta); }
  .btn-ghost::after { content: '→'; transition: transform 0.2s; }
  .btn-ghost:hover::after { transform: translateX(4px); }

  /* ── HERO RIGHT ── */
  .hero-right {
    position: relative;
    overflow: hidden;
    animation: fadeUp 1s ease 0.4s both;
    z-index: 1;
  }

  .hero-image-area {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #f0e8e2 0%, #e4d4c8 40%, #dbc8ba 100%);
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .hero-image-area::before {
    content: '';
    position: absolute;
    top: -10%; right: -10%;
    width: 70%; height: 70%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245,221,232,0.6) 0%, transparent 70%);
    z-index: 1;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    z-index: 2;
  }

  .hero-photo-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 140px;
    background: linear-gradient(to top, var(--color-cream) 0%, transparent 100%);
    z-index: 3;
    pointer-events: none;
  }

  .floating-card {
    position: absolute;
    background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 0.78rem;
    z-index: 5;
    box-shadow: 0 8px 32px rgba(0,0,0,0.09);
  }

  .card-location {
    bottom: 14%;
    right: 8%;
    animation: float2 9s ease-in-out infinite;
  }

  .card-season {
    top: 18%;
    left: 6%;
    animation: float1 11s ease-in-out infinite;
    max-width: 170px;
  }

  .card-label {
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-value {
    color: var(--color-ink);
    font-weight: 500;
    margin-top: 2px;
  }

  /* ── TOPICS ── */
  .topics-section {
    padding: 100px 60px;
    background: var(--color-warm-white);
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 56px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .section-title em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    max-width: 200px;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .topic-card {
    background: var(--color-cream);
    padding: 36px 28px;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: block;
  }

  .topic-card:hover { background: var(--color-warm-white); }

  .topic-card::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    transform: scaleX(0);
    transition: transform 0.3s ease;
    transform-origin: left;
  }

  .topic-card:hover::before { transform: scaleX(1); }

  .tc-terracotta::before { background: var(--color-terracotta); }
  .tc-sage::before        { background: var(--color-sage); }
  .tc-gold::before        { background: var(--color-gold); }
  .tc-dusty-rose::before  { background: var(--color-dusty-rose); }
  .tc-blue::before        { background: #7a9ec4; }
  .tc-lavender::before    { background: #b4a8d4; }

  .topic-icon {
    font-size: 1.8rem;
    margin-bottom: 14px;
    display: block;
  }

  .topic-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .topic-desc {
    font-size: 0.8rem;
    color: var(--color-muted);
    line-height: 1.6;
    font-weight: 300;
  }

  .topic-count {
    display: inline-block;
    margin-top: 14px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* ── POSTS ── */
  .posts-section {
    padding: 100px 60px;
  }

  .no-posts {
    font-size: 1rem;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-style: italic;
    margin-bottom: 40px;
  }

  .posts-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 60px;
    margin-bottom: 48px;
  }

  .featured-post {
    cursor: pointer;
    animation: fadeUp 0.8s ease 0.3s both;
    text-decoration: none;
    display: block;
  }

  .featured-image {
    width: 100%;
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, #e8d5ce 0%, #d4c4ba 50%, #c8b8ae 100%);
    border-radius: 4px;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .featured-image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }

  .featured-image-text {
    color: rgba(80,60,50,0.4);
    font-size: 2rem;
  }

  .featured-category {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-ink);
    margin-bottom: 14px;
    transition: color 0.2s;
  }

  .featured-post:hover .featured-title { color: var(--color-terracotta); }

  .featured-excerpt {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.75;
    margin-bottom: 20px;
    font-weight: 300;
  }

  .post-meta {
    font-size: 0.75rem;
    color: var(--color-muted);
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .posts-sidebar h3 {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-transform: uppercase;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .post-list-item {
    display: block;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
    transition: opacity 0.2s;
    text-decoration: none;
  }

  .post-list-item:hover { opacity: 0.7; }

  .post-list-cat {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sage);
    font-weight: 500;
    margin-bottom: 6px;
  }

  .post-list-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .post-list-date {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  .view-all-wrap {
    text-align: center;
    padding-top: 8px;
  }

  /* ── ABOUT STRIP ── */
  .about-strip {
    background: #1c1a17;
    color: #faf7f2;
    padding: 80px 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-text h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 20px;
    line-height: 1.3;
    color: #faf7f2;
  }

  .about-text h2 em {
    font-style: italic;
    color: var(--color-terracotta-light);
  }

  .about-text p {
    font-size: 0.9rem;
    line-height: 1.85;
    color: rgba(250,247,242,0.7);
    font-weight: 300;
    margin-bottom: 28px;
  }

  .about-link {
    color: var(--color-terracotta-light);
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.2s;
  }

  .about-link::after { content: '→'; }
  .about-link:hover { gap: 14px; }

  .about-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .fact {
    border-top: 1px solid rgba(250,247,242,0.15);
    padding-top: 20px;
  }

