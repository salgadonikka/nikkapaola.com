---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Icon from "../components/Icon.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteConfig, FEATURES } from "../site.config";
import myPhoto from "../assets/myphoto.jpg";

const { hero, aboutStrip, topics, nowTeaser } = siteConfig;

const tagColors: Record<string, { bg: string; color: string }> = {
  life:    { bg: "#f2e4e1", color: "#a0514a" },
  tech:    { bg: "#dfe8f0", color: "#3a5a78" },
  travel:  { bg: "#f0e8d8", color: "#7a5c2a" },
  finance: { bg: "#e0f0f8", color: "#2a5a78" },
  random:  { bg: "#ece8f5", color: "#5a4a80" },
};

const recentFragments = FEATURES.fragments
  ? (await getCollection("fragments")).sort((a, b) => b.id.localeCompare(a.id)).slice(0, 4)
  : [];

const renderedFragments = await Promise.all(
  recentFragments.map(async (fragment) => {
    const { Content } = await render(fragment);
    return { fragment, Content };
  }),
);

---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={siteConfig.title} description={siteConfig.description} />
  </head>
  <body>
    <!-- ── PORTFOLIO SPLASH ── -->
    {FEATURES.portfolioRedirect && (
      <>
        <div class="splash-overlay" id="splash">
          <div class="splash-card">
            <div class="splash-eyebrow">One moment</div>
            <p class="splash-text">Taking you to my portfolio<span class="splash-dots"></span></p>
          </div>
        </div>
        <script is:inline>
          setTimeout(function () {
            window.location.replace('/portfolio');
          }, 1800);
        </script>
      </>
    )}

    <Header />
    <!-- Google Tag Manager (noscript fallback) -->
    {
      siteConfig.analytics.googleTagManagerId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${siteConfig.analytics.googleTagManagerId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <!-- End Google Tag Manager (noscript) -->

    <!-- ── HERO ── -->
    <section class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">{hero.eyebrow}</div>
        <h1 class="hero-title">
          {hero.titleLine1}<br />
          <em>{hero.titleLine2}</em>
        </h1>
        <p class="hero-tagline">{hero.tagline}</p>
        <div class="hero-tags">
          {
            hero.tags.map((tag) => (
              <span class={`tag ${tag.style}`}>{tag.label}</span>
            ))
          }
        </div>
        <div class="hero-cta">
          <a href="/blog" class="btn-primary">Read the blog</a>
          <a href="/about" class="btn-ghost">About me</a>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-image-area">
          <Image
            src={myPhoto}
            alt={hero.photoAlt}
            class="hero-photo"
            widths={[800, 1200]}
            sizes="50vw"
          />
          <div class="hero-photo-fade"></div>

          <div class="floating-card card-location">
            <div class="card-label">
              <Icon name={hero.floatingCards[0].icon} size={12} weight="duotone" class="floating-card-icon" />
              {hero.floatingCards[0].label}
            </div>
            <div class="card-value">{hero.floatingCards[0].value}</div>
          </div>

          <div class="floating-card card-season">
            <div class="card-label">
              <Icon name={hero.floatingCards[1].icon} size={12} weight="duotone" class="floating-card-icon" />
              {hero.floatingCards[1].label}
            </div>
            <div class="card-value">{hero.floatingCards[1].value}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── TOPICS ── -->
    <section class="topics-section">
      <div class="section-header">
        <h2 class="section-title">What I write <em>about</em></h2>
        <div class="section-line"></div>
      </div>
      <div class="topics-grid">
        {
          topics.map((t) => (
            <a href={`/blog?cat=${t.cat}`} class={`topic-card tc-${t.color}`}>
              <span class="topic-icon"><Icon name={t.icon} size={28} weight="duotone" /></span>
              <div class="topic-name">{t.name}</div>
              <div class="topic-desc">{t.desc}</div>
              <span class="topic-count">{t.count}</span>
            </a>
          ))
        }
      </div>
      <div class="topics-dev-strip">
        <Icon name="Code" size={14} weight="duotone" class="topics-dev-icon" />
        <span>Also interested in the technical side?</span>
        <a href="https://dev.nikkapaola.com" class="topics-dev-link" target="_blank" rel="noopener noreferrer">dev.nikkapaola.com →</a>
      </div>
    </section>

    <!-- ── RECENCY ROW: fragments + now ── -->
    {(FEATURES.fragments && renderedFragments.length > 0) || FEATURES.nowPage ? (
      <section class="recency-section">
        <div class="recency-grid">

          {FEATURES.fragments && renderedFragments.length > 0 && (
            <div class="recency-fragments">
              <div class="recency-col-header">
                <h2 class="recency-col-title">Life <em>lately</em></h2>
                <a href="/fragments" class="frags-view-all">All fragments →</a>
              </div>
              <div class="fragments-strip">
                {renderedFragments.map(({ fragment, Content }, i) => {
                  const tagInfo = fragment.data.tag ? tagColors[fragment.data.tag] : null;
                  const isTeaser = i === 3;
                  const isQuote = !fragment.data.image && !fragment.data.video;
                  return (
                    <a
                      href={isTeaser ? "/fragments" : `/fragments#frag-${fragment.id}`}
                      class={`home-frag-card${isTeaser ? " home-frag-card--teaser" : ""}${isQuote ? " home-frag-card--quote" : ""}`}
                    >
                      {fragment.data.video && (
                        <div class="hfc-media">
                          <video src={fragment.data.video} autoplay muted loop playsinline class="hfc-video" />
                        </div>
                      )}
                      {fragment.data.image && !fragment.data.video && (
                        <div class="hfc-media">
                          <Image src={fragment.data.image} alt="" width={400} height={200} class="hfc-img" />
                        </div>
                      )}
                      <div class="hfc-body">
                        <div class="hfc-meta">
                          <time datetime={fragment.data.date.toISOString()} data-frag-ts={fragment.data.date.toISOString()}>
                            {fragment.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                          </time>
                          {fragment.data.tag && tagInfo && (
                            <span class="hfc-tag-pill" style={`background:${tagInfo.bg};color:${tagInfo.color}`}>
                              {fragment.data.tag}
                            </span>
                          )}
                        </div>
                        <div class="hfc-text"><Content /></div>
                      </div>
                      {isTeaser && (
                        <div class="frag-see-more">
                          <span>See more</span>
                          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <polyline points="6 3 12 8 6 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </div>
                      )}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          {FEATURES.nowPage && (
            <div class="recency-now">
              <div class="recency-col-header">
                <div class="now-eyebrow">
                  <span class="live-dot" aria-hidden="true"></span>
                  Right now
                </div>
                <a href="/now" class="frags-view-all">Full /now →</a>
              </div>
              <h2 class="now-teaser-title">What I'm <em>up to</em></h2>
              <ul class="now-bullets">
                {nowTeaser.bullets.map((b) => (
                  <li class="now-bullet">
                    <span class="now-bullet-icon"><Icon name={b.icon} size={16} weight="duotone" /></span>
                    <span>{b.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </div>
      </section>
    ) : null}

    <!-- ── ABOUT STRIP ── -->
    <section class="about-strip" id="about">
      <div class="about-text">
        <h2>A little about <em>who I am</em></h2>
        <p>{aboutStrip.bio}</p>
        <a href="/about" class="about-link">Read the full story</a>
      </div>
      <div class="about-facts">
        {
          aboutStrip.facts.map((fact) => (
            <div class="fact">
              <span class="fact-icon"><Icon name={fact.icon} size={22} weight="duotone" /></span>
              <div class="fact-label">{fact.label}</div>
              <div class="fact-value">{fact.value}</div>
            </div>
          ))
        }
      </div>
    </section>

    <Footer />
  </body>
</html>

<script>
  function relativeTime(iso: string): string {
    const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (diff < 60) return "just now";
    if (diff < 3600) { const m = Math.floor(diff / 60); return `${m} ${m === 1 ? "min" : "mins"} ago`; }
    if (diff < 86400) { const h = Math.floor(diff / 3600); return `${h} ${h === 1 ? "hour" : "hours"} ago`; }
    if (diff < 172800) return "yesterday";
    if (diff < 604800) { const d = Math.floor(diff / 86400); return `${d} days ago`; }
    const date = new Date(iso);
    return date.toLocaleDateString("en-US", {
      month: "short", day: "numeric",
      ...(date.getFullYear() !== new Date().getFullYear() ? { year: "numeric" } : {}),
    });
  }
  document.querySelectorAll<HTMLTimeElement>("time[data-frag-ts]").forEach((el) => {
    const ts = el.dataset.fragTs!;
    el.textContent = relativeTime(ts);
    el.title = new Date(ts).toLocaleString("en-US", { month: "long", day: "numeric", year: "numeric" });
  });
</script>

<style>
  .splash-overlay {
    position: fixed;
    inset: 0;
    background: rgba(28, 26, 23, 0.70);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: splashIn 0.45s ease both;
  }

  @keyframes splashIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .splash-card {
    text-align: center;
    padding: 0 24px;
  }

  .splash-eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(184, 150, 90, 0.85);
    margin-bottom: 14px;
  }

  .splash-text {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 400;
    font-style: italic;
    color: rgba(250, 247, 242, 0.92);
    margin: 0;
  }

  .splash-dots::after {
    content: '';
    animation: dots 1.2s steps(4, end) infinite;
  }

  @keyframes dots {
    0%,  19% { content: '';   }
    20%, 39% { content: '.';  }
    40%, 59% { content: '..'; }
    60%, 100%{ content: '...'; }
  }
</style>

<style>
  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 80px;
    overflow: hidden;
    position: relative;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        ellipse at 80% 20%,
        rgba(245, 221, 232, 0.35) 0%,
        transparent 55%
      ),
      radial-gradient(
        ellipse at 10% 80%,
        rgba(212, 228, 217, 0.25) 0%,
        transparent 45%
      );
    pointer-events: none;
    z-index: 0;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 60px;
    animation: fadeUp 1s ease 0.2s both;
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--color-terracotta);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 4.8vw, 4.2rem);
    line-height: 1.12;
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .hero-title em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-muted);
    margin-bottom: 20px;
  }

  .hero-bio {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--color-ink-soft);
    max-width: 440px;
    margin-bottom: 32px;
    font-weight: 300;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }

  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .tag-rose {
    background: #f2e4e1;
    color: #a0514a;
  }
  .tag-sage {
    background: var(--color-sage-light);
    color: #3d6b4f;
  }
  .tag-gold {
    background: #f0e8d8;
    color: #7a5c2a;
  }
  .tag-blue {
    background: #dfe8f0;
    color: #3a5a78;
  }
  .tag-lavender {
    background: #ece8f5;
    color: #5a4a80;
  }
  .tag-blossom {
    background: var(--color-blossom);
    color: #9a4870;
  }

  :global(html[data-theme="dark"]) .tag-rose {
    background: #3d2220;
    color: #e8a090;
  }
  :global(html[data-theme="dark"]) .tag-sage {
    color: #7dba96;
  }
  :global(html[data-theme="dark"]) .tag-gold {
    background: #2e2416;
    color: #d4a85c;
  }
  :global(html[data-theme="dark"]) .tag-blue {
    background: #1a2535;
    color: #7aafd4;
  }
  :global(html[data-theme="dark"]) .tag-lavender {
    background: #221a35;
    color: #a090d4;
  }
  :global(html[data-theme="dark"]) .tag-blossom {
    color: #d47aaa;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .tag-rose {
      background: #3d2220;
      color: #e8a090;
    }
    :global(html:not([data-theme="light"])) .tag-sage {
      color: #7dba96;
    }
    :global(html:not([data-theme="light"])) .tag-gold {
      background: #2e2416;
      color: #d4a85c;
    }
    :global(html:not([data-theme="light"])) .tag-blue {
      background: #1a2535;
      color: #7aafd4;
    }
    :global(html:not([data-theme="light"])) .tag-lavender {
      background: #221a35;
      color: #a090d4;
    }
    :global(html:not([data-theme="light"])) .tag-blossom {
      color: #d47aaa;
    }
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .btn-primary {
    background: var(--color-terracotta);
    color: white;
    padding: 13px 28px;
    border-radius: 3px;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
    display: inline-block;
  }

  .btn-primary:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-1px);
  }

  .btn-ghost {
    color: var(--color-ink-soft);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }

  .btn-ghost:hover {
    color: var(--color-terracotta);
  }
  .btn-ghost::after {
    content: "→";
    transition: transform 0.2s;
  }
  .btn-ghost:hover::after {
    transform: translateX(4px);
  }

  /* ── HERO RIGHT ── */
  .hero-right {
    position: relative;
    overflow: hidden;
    animation: fadeUp 1s ease 0.4s both;
    z-index: 1;
  }

  .hero-image-area {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #f0e8e2 0%, #e4d4c8 40%, #dbc8ba 100%);
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .hero-image-area::before {
    content: "";
    position: absolute;
    top: -10%;
    right: -10%;
    width: 70%;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(245, 221, 232, 0.6) 0%,
      transparent 70%
    );
    z-index: 1;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    z-index: 2;
  }

  .hero-photo-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 140px;
    background: linear-gradient(
      to top,
      var(--color-cream) 0%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  .floating-card {
    position: absolute;
    background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 0.78rem;
    z-index: 5;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.09);
  }

  .floating-card-icon {
    color: var(--color-terracotta);
  }

  .card-location {
    bottom: 14%;
    right: 8%;
    animation: float2 9s ease-in-out infinite;
  }

  .card-season {
    top: 18%;
    left: 6%;
    animation: float1 11s ease-in-out infinite;
    max-width: 170px;
  }

  .card-label {
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-value {
    color: var(--color-ink);
    font-weight: 500;
    margin-top: 2px;
  }

  /* ── TOPICS ── */
  .topics-section {
    padding: 100px 60px;
    background: var(--color-warm-white);
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 56px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .section-title em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    max-width: 200px;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .topic-card {
    background: var(--color-cream);
    padding: 36px 28px;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: block;
  }

  .topic-card:hover {
    background: var(--color-warm-white);
  }

  .topic-card::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    transform: scaleX(0);
    transition: transform 0.3s ease;
    transform-origin: left;
  }

  .topic-card:hover::before {
    transform: scaleX(1);
  }

  .tc-terracotta::before {
    background: var(--color-terracotta);
  }
  .tc-sage::before {
    background: var(--color-sage);
  }
  .tc-gold::before {
    background: var(--color-gold);
  }
  .tc-dusty-rose::before {
    background: var(--color-dusty-rose);
  }
  .tc-blue::before {
    background: #7a9ec4;
  }
  .tc-lavender::before {
    background: #b4a8d4;
  }

  .topic-icon {
    display: flex;
    margin-bottom: 14px;
    color: var(--color-terracotta);
  }

  .topic-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .topic-desc {
    font-size: 0.8rem;
    color: var(--color-muted);
    line-height: 1.6;
    font-weight: 300;
  }

  .topic-count {
    display: inline-block;
    margin-top: 14px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .topics-dev-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .topics-dev-icon {
    color: var(--color-terracotta);
    flex-shrink: 0;
  }

  .topics-dev-link {
    color: var(--color-terracotta);
    text-decoration: none;
    font-weight: 500;
    transition: letter-spacing 0.2s;
  }

  .topics-dev-link:hover {
    letter-spacing: 0.03em;
  }

  /* ── POSTS ── */
  .posts-section {
    padding: 100px 60px;
  }

  .no-posts {
    font-size: 1rem;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-style: italic;
    margin-bottom: 40px;
