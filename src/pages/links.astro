<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     STYLE OVERRIDES
     By default this page inherits everything from src/styles/global.css:
       • Colors  → var(--color-cream), var(--color-terracotta), etc.
       • Fonts   → var(--font-serif) / var(--font-sans)
       • Dark mode → automatic via global.css media query
       • Base reset, body background, and typography

     Uncomment any block below to override just that piece for this page.
     All other pages are unaffected.
  ═══════════════════════════════════════════════════════════════════════════ */

  /*
  OVERRIDE: Page background
  Default: var(--color-cream) — inherits from body in global.css.
  Tip: When Header is commented out, also remove padding-top from .links-page.

  .links-page {
    background: linear-gradient(135deg, #faf7f2 0%, #f5dde8 100%);
  }
  */

  /*
  OVERRIDE: Accent color (featured button, copy btn, social hover, eyebrow text)
  Default: var(--color-terracotta) / var(--color-terracotta-dark)

  .link-btn.featured,
  .link-btn.featured:focus { background: var(--color-sage); border-color: var(--color-sage); }
  .link-btn.featured:hover { background: #5a8069; border-color: #5a8069; }
  .copy-btn { color: var(--color-sage); }
  .copy-btn:hover { background: var(--color-sage); border-color: var(--color-sage); }
  .latest-post-eyebrow { color: var(--color-sage); }
  .social-icon:hover { color: var(--color-sage); border-color: var(--color-sage); }
  */

  /*
  OVERRIDE: Link button shape — change to pill style
  Default: border-radius 12px (rounded rectangle)

  .link-btn { border-radius: 999px; }
  .discount-card { border-radius: 999px; }
  .copy-btn { border-radius: 999px; }
  */

  /*
  OVERRIDE: Link button fill — solid tinted background instead of white
  Default: white background with --color-border border

  .link-btn {
    background: var(--color-warm-white);
    border-color: transparent;
  }
  */

  /*
  OVERRIDE: Profile name font
  Default: var(--font-serif) (Playfair Display)

  .profile-name { font-family: var(--font-sans); font-weight: 600; }
  */

  /*
  OVERRIDE: Newsletter block background
  Default: var(--color-blossom)

