    <Header />

    <div class="links-page">
      <main>
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 1: Profile Header  (always shown)                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="profile">
          <!--
            Avatar: swap src with your photo URL or a local asset.
            Recommended: 200×200px square, hosted on Cloudinary or a CDN.
          -->
          <img
            class="profile-avatar"
            src="/../assets/portfolio-photo.jpg"
            alt={author.name}
            width="88"
            height="88"
          />
          <h1 class="profile-name">{author.name}</h1>
          <p class="profile-bio">{author.bio}</p>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 2: Featured / Pinned CTA Link                          -->
        <!-- Uncomment to add one prominent call-to-action at the top.      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--
        <a href="https://your-link.com" class="link-btn featured" target="_blank" rel="noopener">
          <span class="link-btn-icon">✨</span>
          Your Big Announcement or Link
        </a>
        -->

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 3: Main Link List                                       -->
        <!-- Add, remove, or reorder <a> tags. Each gets hover animation.  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <a href="/blog" class="link-btn">
          <span class="link-btn-icon">📝</span>
          Read My Blog
        </a>

        <a href="/about" class="link-btn">
          <span class="link-btn-icon">👋</span>
          About Me
        </a>

        <!-- More link examples — uncomment and fill in your URLs:
        <a href="https://your-shop.com" class="link-btn" target="_blank" rel="noopener">
          <span class="link-btn-icon">🛍️</span>
          Shop My Picks
        </a>

        <a href="https://your-course.com" class="link-btn" target="_blank" rel="noopener">
          <span class="link-btn-icon">🎓</span>
          Free Course / Workshop
        </a>

        <a href="https://your-podcast.com" class="link-btn" target="_blank" rel="noopener">
          <span class="link-btn-icon">🎙️</span>
          Listen to My Podcast
        </a>

        <a href="https://presets.your-site.com" class="link-btn" target="_blank" rel="noopener">
          <span class="link-btn-icon">🎨</span>
          Download My Lightroom Presets
        </a>

        <a href="/projects" class="link-btn">
          <span class="link-btn-icon">🚀</span>
          My Projects
        </a>
        -->

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 4: Section Dividers                                     -->
        <!-- Uncomment to group links under labeled headings.               -->
        <!-- Place a divider between any two links in Section 3.            -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
