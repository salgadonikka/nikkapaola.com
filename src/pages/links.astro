        -->

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 6: Latest Blog Post (dynamic)                           -->
        <!-- 1. Uncomment the getCollection block in the frontmatter above.  -->
        <!-- 2. Uncomment this HTML block.                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--
        {latestPost && (
          <a href={`/blog/${latestPost.slug}`} class="latest-post-card">
            <span class="latest-post-eyebrow">✦ Latest Post</span>
            <span class="latest-post-title">{latestPost.data.title}</span>
            {latestPost.data.description && (
              <span class="latest-post-desc">{latestPost.data.description}</span>
            )}
          </a>
        )}
        -->

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 7: Newsletter Sign-Up                                   -->
