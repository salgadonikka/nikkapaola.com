---
import { FEATURES, siteConfig } from "../site.config";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

if (!FEATURES.guestbook) {
  return Astro.redirect("/");
}

// TODO: Build out the guestbook page.
// Options for the backend:
//   - Supabase (free tier, easy REST API) — store name + message + timestamp
//   - Turso (SQLite at the edge) — lightweight, free tier
//   - Netlify Forms / Formspree — simplest, no custom backend needed
// The form should POST to an API route (src/pages/api/guestbook.ts)
// that validates and saves the entry, then redirects back here.
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Guestbook - ${siteConfig.title}`}
      description={`Leave a note for ${siteConfig.author.shortName}.`}
    />
  </head>
  <body>
    <Header />
    <main>
      <h1>Guestbook — coming soon</h1>
    </main>
    <Footer />
  </body>
</html>
