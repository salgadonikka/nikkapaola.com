---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { FEATURES } from "../site.config";

if (!FEATURES.fragments) return Astro.redirect("/404");

const allFragments = await getCollection("fragments");
// Sort by id descending: filename format YYYY-MM-DD-NNN sorts date and
// same-day sequence number together without needing separate comparisons.
const fragments = allFragments.sort((a, b) => b.id.localeCompare(a.id));

function parseSpotifyEmbed(url: string): string | null {
  const m = url.match(
    /open\.spotify\.com\/(track|album|playlist)\/([A-Za-z0-9]+)/,
  );
  if (!m) return null;
  return `https://open.spotify.com/embed/${m[1]}/${m[2]}?utm_source=generator&theme=0`;
}

function parseYoutubeId(url: string): string | null {
  const m = url.match(/(?:youtu\.be\/|[?&]v=|\/shorts\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}

const tagColors: Record<string, { bg: string; color: string }> = {
  life: { bg: "#f2e4e1", color: "#a0514a" },
  tech: { bg: "#dfe8f0", color: "#3a5a78" },
  travel: { bg: "#f0e8d8", color: "#7a5c2a" },
  finance: { bg: "#e0f0f8", color: "#2a5a78" },
  random: { bg: "#ece8f5", color: "#5a4a80" },
};

const rendered = await Promise.all(
  fragments.map(async (fragment) => {
    const { Content } = await render(fragment);
    const spotifyEmbed = fragment.data.spotify
      ? parseSpotifyEmbed(fragment.data.spotify)
      : null;
    const youtubeId = fragment.data.youtube
      ? parseYoutubeId(fragment.data.youtube)
      : null;
    return { fragment, Content, spotifyEmbed, youtubeId };
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Fragments - nikkapaola.com"
      description="Short thoughts, small moments, and everything in between. Not quite a post, not quite a note. Just fragments."
    />
  </head>
  <body>
    <Header />

    <main>
      <div class="page-intro">
        <div class="eyebrow">Fragments</div>
        <h1>Life lately: <em>bits and pieces</em></h1>
        <p class="subtitle">
          Little fragments of my daily life, when I feel like sharing something
          short and cute.
        </p>
      </div>

      {
        fragments.length === 0 ? (
          <p class="empty-state">"Fragments are coming. Check back soon."</p>
        ) : (
          <div class="fragment-wall">
            {rendered.map(({ fragment, Content, spotifyEmbed, youtubeId }) => {
              const tagInfo = fragment.data.tag
                ? tagColors[fragment.data.tag]
                : null;

              const cardMedia = spotifyEmbed ? (
                <div class="card-media card-media--spotify">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.516 17.314a.748.748 0 0 1-1.031.25c-2.824-1.725-6.376-2.115-10.564-1.158a.748.748 0 1 1-.334-1.458c4.583-1.049 8.517-.597 11.68 1.335a.748.748 0 0 1 .249 1.031zm1.472-3.27a.937.937 0 0 1-1.288.308c-3.231-1.985-8.157-2.56-11.977-1.401a.937.937 0 0 1-.545-1.793c4.363-1.325 9.786-.683 13.502 1.598a.937.937 0 0 1 .308 1.288zm.127-3.405C15.37 8.39 9.394 8.19 5.82 9.274a1.124 1.124 0 1 1-.653-2.151c4.114-1.249 10.952-1.008 15.265 1.574a1.124 1.124 0 1 1-1.317 1.942z" />
                  </svg>
                  <span class="card-media-label">Listening ♫</span>
                </div>
              ) : youtubeId ? (
                <div class="card-media card-media--youtube">
                  <img
                    src={`https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`}
                    alt=""
                    loading="lazy"
                  />
                  <div class="play-btn" aria-hidden="true">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              ) : null;

              return (
                <button
                  class="fragment-card"
                  id={`frag-${fragment.id}`}
                  data-id={fragment.id}
                  data-tag={fragment.data.tag ?? ""}
                  data-tag-bg={tagInfo?.bg ?? ""}
                  data-tag-color={tagInfo?.color ?? ""}
                  data-emoji={fragment.data.emoji ?? ""}
                  aria-label="Open fragment"
                >
                  {fragment.data.image && (
                    <div class="card-image">
                      <Image
                        src={fragment.data.image}
                        alt=""
                        width={600}
                        height={600}
                        format="webp"
                        loading="lazy"
                      />
                    </div>
                  )}
                  {cardMedia}
                  <div class="card-body">
                    <div class="card-meta">
                      <time
                        datetime={fragment.data.date.toISOString()}
                        data-timestamp={fragment.data.date.toISOString()}
                      >
                        {fragment.data.date.toLocaleDateString("en-US", {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })}
                      </time>
                      {fragment.data.tag && tagInfo && (
                        <span
                          class="tag-pill"
                          style={`background: ${tagInfo.bg}; color: ${tagInfo.color};`}
                        >
                          {fragment.data.tag}
                        </span>
                      )}
                      {fragment.data.emoji && (
                        <span class="card-emoji">{fragment.data.emoji}</span>
                      )}
                    </div>
                    <div class="card-text">
                      <Content />
                    </div>
                  </div>
                </button>
              );
            })}
          </div>
        )
      }
    </main>

    <!-- Hidden content store: full-res images + rendered text, cloned into modal on open -->
    <div hidden aria-hidden="true">
      {
        rendered.map(({ fragment, Content, spotifyEmbed, youtubeId }) => (
          <div
            id={`store-${fragment.id}`}
            data-spotify-embed={spotifyEmbed ?? ""}
            data-youtube-id={youtubeId ?? ""}
          >
            {fragment.data.image && (
              <div class="store-image">
                <Image
                  src={fragment.data.image}
                  alt=""
                  width={900}
                  height={900}
                  format="webp"
                  loading="lazy"
                />
              </div>
            )}
            <div class="store-date">
              <time
                datetime={fragment.data.date.toISOString()}
                data-timestamp={fragment.data.date.toISOString()}
              >
                {fragment.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
            </div>
            <div class="store-text">
              <Content />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Fragment modal -->
    <dialog id="fragment-modal" aria-label="Fragment detail" aria-modal="true">
      <!-- Close sits outside the scroll area so it never scrolls away -->
      <button class="modal-close" aria-label="Close">
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <line
            x1="2"
            y1="2"
            x2="14"
            y2="14"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></line>
          <line
            x1="14"
            y1="2"
            x2="2"
            y2="14"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></line>
        </svg>
      </button>

      <!-- Scrollable content area -->
      <div class="modal-scroll">
        <div class="modal-image-wrap" hidden></div>
        <div class="modal-media-wrap" hidden></div>

        <div class="modal-body">
          <div class="modal-meta">
            <span class="modal-date"></span>
            <span class="modal-tag" hidden></span>
            <span class="modal-emoji" hidden></span>
          </div>
          <div class="modal-text"></div>
          <div class="modal-actions">
            <button class="modal-share">
              <svg
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  cx="13"
                  cy="3"
                  r="2"
                  stroke="currentColor"
                  stroke-width="1.4"></circle>
                <circle
                  cx="13"
                  cy="13"
                  r="2"
                  stroke="currentColor"
                  stroke-width="1.4"></circle>
                <circle
                  cx="3"
                  cy="8"
                  r="2"
                  stroke="currentColor"
                  stroke-width="1.4"></circle>
                <line
                  x1="4.9"
                  y1="7.1"
                  x2="11.1"
                  y2="3.9"
                  stroke="currentColor"
                  stroke-width="1.4"></line>
                <line
                  x1="4.9"
                  y1="8.9"
                  x2="11.1"
                  y2="12.1"
                  stroke="currentColor"
                  stroke-width="1.4"></line>
              </svg>
              <span class="share-label">Share</span>
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <Footer />
  </body>
</html>

<script>
  // ── Relative time ──────────────────────────────────────────────────────────
  function relativeTime(isoString: string): string {
    const diff = Math.floor(
      (Date.now() - new Date(isoString).getTime()) / 1000,
    );
    if (diff < 60) return "just now";
    if (diff < 3600) {
      const m = Math.floor(diff / 60);
      return `${m} ${m === 1 ? "min" : "mins"} ago`;
    }
    if (diff < 86400) {
      const h = Math.floor(diff / 3600);
      return `${h} ${h === 1 ? "hour" : "hours"} ago`;
    }
    if (diff < 172800) return "yesterday";
    if (diff < 604800) {
      const d = Math.floor(diff / 86400);
      return `${d} days ago`;
    }
    // Older: show the actual date
    const date = new Date(isoString);
    const sameYear = date.getFullYear() === new Date().getFullYear();
    return date.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      ...(sameYear ? {} : { year: "numeric" }),
    });
  }

  function updateAllTimestamps() {
    document
      .querySelectorAll<HTMLTimeElement>("time[data-timestamp]")
      .forEach((el) => {
        const ts = el.dataset.timestamp!;
        el.textContent = relativeTime(ts);
        // Tooltip shows the exact datetime on hover
        el.title = new Date(ts).toLocaleString("en-US", {
          month: "long",
          day: "numeric",
          year: "numeric",
          hour: "numeric",
          minute: "2-digit",
        });
      });
  }

  updateAllTimestamps();
  setInterval(updateAllTimestamps, 60_000);

  // ── Modal ──────────────────────────────────────────────────────────────────
  const modal = document.getElementById("fragment-modal") as HTMLDialogElement;
  const modalImageWrap = modal.querySelector(
    ".modal-image-wrap",
  ) as HTMLElement;
  const modalMediaWrap = modal.querySelector(
    ".modal-media-wrap",
  ) as HTMLElement;
  const modalDate = modal.querySelector(".modal-date") as HTMLElement;
  const modalTag = modal.querySelector(".modal-tag") as HTMLElement;
  const modalEmoji = modal.querySelector(".modal-emoji") as HTMLElement;
  const modalText = modal.querySelector(".modal-text") as HTMLElement;
  const modalShare = modal.querySelector(".modal-share") as HTMLButtonElement;
  const modalScroll = modal.querySelector(".modal-scroll") as HTMLElement;
  const modalClose = modal.querySelector(".modal-close") as HTMLButtonElement;
  const shareLabel = modalShare.querySelector(".share-label") as HTMLElement;

  let currentId = "";

  function openModal(card: HTMLElement) {
    const id = card.dataset.id!;
    currentId = id;
    // Capture scroll position before showModal() can move it
    const scrollY = window.scrollY;

    const store = document.getElementById(`store-${id}`)!;

    // Image
    const storedImage = store.querySelector(".store-image");
    if (storedImage) {
      modalImageWrap.innerHTML = "";
      modalImageWrap.appendChild(storedImage.cloneNode(true));
      modalImageWrap.hidden = false;
    } else {
      modalImageWrap.hidden = true;
    }

    // Spotify / YouTube embed
    const spotifyEmbed = (store as HTMLElement).dataset.spotifyEmbed;
    const youtubeId = (store as HTMLElement).dataset.youtubeId;
    if (spotifyEmbed) {
      const iframe = document.createElement("iframe");
      iframe.src = spotifyEmbed;
      iframe.width = "100%";
      iframe.height = "152";
      iframe.allow =
        "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
      iframe.setAttribute("loading", "lazy");
      iframe.style.display = "block";
      iframe.style.border = "none";
      modalMediaWrap.innerHTML = "";
      modalMediaWrap.appendChild(iframe);
      modalMediaWrap.hidden = false;
    } else if (youtubeId) {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube.com/embed/${youtubeId}?autoplay=1`;
      iframe.width = "100%";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.setAttribute("loading", "lazy");
      iframe.style.display = "block";
      iframe.style.border = "none";
      iframe.style.aspectRatio = "16/9";
      modalMediaWrap.innerHTML = "";
      modalMediaWrap.appendChild(iframe);
      modalMediaWrap.hidden = false;
    } else {
      modalMediaWrap.innerHTML = "";
      modalMediaWrap.hidden = true;
    }

    // Date
    const storedDate = store.querySelector(".store-date")!;
    modalDate.innerHTML = storedDate.innerHTML;
    // Refresh relative time on the freshly cloned <time> element
    const modalTimeEl = modalDate.querySelector<HTMLTimeElement>(
      "time[data-timestamp]",
    );
    if (modalTimeEl) {
      const ts = modalTimeEl.dataset.timestamp!;
      modalTimeEl.textContent = relativeTime(ts);
      modalTimeEl.title = new Date(ts).toLocaleString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
        hour: "numeric",
        minute: "2-digit",
      });
    }

    // Tag
    const tag = card.dataset.tag;
    const tagBg = card.dataset.tagBg;
    const tagColor = card.dataset.tagColor;
    if (tag) {
      modalTag.textContent = tag;
      modalTag.setAttribute(
        "style",
        `background: ${tagBg}; color: ${tagColor};`,
      );
      modalTag.hidden = false;
    } else {
      modalTag.hidden = true;
    }

    // Emoji
    const emoji = card.dataset.emoji;
    if (emoji) {
      modalEmoji.textContent = emoji;
      modalEmoji.hidden = false;
    } else {
      modalEmoji.hidden = true;
    }

    // Text content
    const storedText = store.querySelector(".store-text")!;
    modalText.innerHTML = storedText.innerHTML;

    // Reset share button
    shareLabel.textContent = "Share";
    modalShare.disabled = false;

    modalScroll.scrollTop = 0;
    // Lock page scroll so the background doesn't jump
    document.documentElement.style.overflow = "hidden";
    modal.showModal();
    // Restore scroll position in case showModal() moved it
    window.scrollTo(0, scrollY);
  }

  function closeModal() {
    document.documentElement.style.overflow = "";
    // Clear media iframes so audio/video stops
    modalMediaWrap.innerHTML = "";
    modalMediaWrap.hidden = true;
    modal.close();
  }

  // Open on card click
  document.querySelectorAll<HTMLElement>(".fragment-card").forEach((card) => {
    card.addEventListener("click", () => openModal(card));
  });

  // Close on X button
  modalClose.addEventListener("click", closeModal);

  // Close on backdrop click (click outside modal-inner)
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Fires for both Escape key and closeModal() - always clean up overflow lock
  modal.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    shareLabel.textContent = "Share";
    modalShare.disabled = false;
  });

  // ── Round-robin masonry columns ──────────────────────────────────────────
  // CSS `columns` fills top-to-bottom then wraps (column-major order).
  // We want left-to-right then down (row-major), so we redistribute cards
  // into column divs in round-robin order via JS.
  const masonryWall = document.querySelector<HTMLElement>(".fragment-wall");
  const masonryCards = masonryWall
    ? Array.from(
        masonryWall.querySelectorAll<HTMLElement>(".fragment-card"),
      )
    : [];

  function buildMasonryCols(): void {
    if (!masonryWall || masonryCards.length === 0) return;
    const n =
      window.innerWidth > 1024 ? 3 : window.innerWidth >= 641 ? 2 : 1;

    masonryWall.innerHTML = "";

    if (n === 1) {
      masonryWall.style.cssText =
        "display:flex;flex-direction:column;gap:20px;";
      masonryCards.forEach((card) => {
        card.style.marginBottom = "0";
        masonryWall.appendChild(card);
      });
      return;
    }

    masonryWall.style.cssText =
      "display:flex;align-items:flex-start;gap:20px;";

    const colEls = Array.from({ length: n }, () => {
      const col = document.createElement("div");
      col.style.cssText =
        "flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:20px;";
      masonryWall.appendChild(col);
      return col;
    });

    masonryCards.forEach((card, i) => {
      card.style.marginBottom = "0";
      colEls[i % n].appendChild(card);
    });
  }

  buildMasonryCols();

  let _colResizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(_colResizeTimer);
    _colResizeTimer = setTimeout(buildMasonryCols, 120);
  });

  // Share button
  modalShare.addEventListener("click", async () => {
    const url = `${window.location.origin}/fragments#frag-${currentId}`;

    if (navigator.share) {
      try {
        await navigator.share({ url });
      } catch {
        // User cancelled - do nothing
      }
    } else {
      await navigator.clipboard.writeText(url);
      shareLabel.textContent = "Copied!";
      modalShare.disabled = true;
      setTimeout(() => {
        shareLabel.textContent = "Share";
        modalShare.disabled = false;
      }, 2000);
    }
  });
</script>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 120px 60px 100px;
  }

  /* ── INTRO ── */
  .page-intro {
    text-align: center;
    margin-bottom: 56px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .eyebrow::before,
  .eyebrow::after {
    content: "";
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--color-terracotta);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  h1 em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  .subtitle {
    font-size: 0.92rem;
    color: var(--color-muted);
    font-weight: 300;
    line-height: 1.8;
    max-width: 680px;
    margin: 0 auto;
  }

  /* ── EMPTY STATE ── */
  .empty-state {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-muted);
    font-size: 1.1rem;
    padding: 60px 0;
  }

  /* ── MASONRY WALL ── */
  .fragment-wall {
    columns: 3;
    column-gap: 20px;
  }

  /* ── FRAGMENT CARD ── */
  .fragment-card {
    all: unset;
    display: block;
    position: relative;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    text-align: left;
    width: 100%;
    box-sizing: border-box;
    /* Masonry: keep each card in one column, space below */
    break-inside: avoid;
    margin-bottom: 20px;
  }

  .fragment-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-terracotta);
    box-shadow:
      0 0 0 1px var(--color-terracotta),
      0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .fragment-card:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 2px;
  }

  /* Shine sweep - light catches the glass on hover */
  .fragment-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    pointer-events: none;
    z-index: 1;
  }

  .fragment-card:hover::before {
    animation: glass-shine 0.55s ease forwards;
  }

  @keyframes glass-shine {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(200%);
    }
  }

  .card-image {
    aspect-ratio: 1 / 1;
    background: rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-body {
    padding: 18px 20px 20px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .tag-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-emoji {
    font-size: 0.9rem;
    line-height: 1;
  }

  .card-text {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.8;
    font-weight: 300;
  }

  .card-text p {
    margin: 0;
  }
  .card-text p + p {
    margin-top: 0.75em;
  }

  /* ── CARD MEDIA (Spotify / YouTube) ── */
  .card-media {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  /* Spotify preview */
  .card-media--spotify {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: #121212;
    color: #1db954;
  }

  .card-media-label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #1db954;
  }

  /* YouTube thumbnail preview */
  .card-media--youtube {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

