---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { FEATURES, siteConfig } from "../site.config";

if (!FEATURES.fragments) return Astro.redirect("/404");

const allFragments = await getCollection("fragments");
// Sort by id descending: filename format YYYY-MM-DD-NNN sorts date and
// same-day sequence number together without needing separate comparisons.
const fragments = allFragments.sort((a, b) => b.id.localeCompare(a.id));

function parseSpotifyEmbed(url: string): string | null {
  const m = url.match(
    /open\.spotify\.com\/(track|album|playlist)\/([A-Za-z0-9]+)/,
  );
  if (!m) return null;
  return `https://open.spotify.com/embed/${m[1]}/${m[2]}?utm_source=generator&theme=0`;
}

function parseYoutubeId(url: string): string | null {
  const m = url.match(/(?:youtu\.be\/|[?&]v=|\/shorts\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}

const tagColors: Record<string, { bg: string; color: string }> = {
  life: { bg: "#f2e4e1", color: "#a0514a" },
  tech: { bg: "#dfe8f0", color: "#3a5a78" },
  travel: { bg: "#f0e8d8", color: "#7a5c2a" },
  finance: { bg: "#e0f0f8", color: "#2a5a78" },
  random: { bg: "#ece8f5", color: "#5a4a80" },
};

const rendered = await Promise.all(
  fragments.map(async (fragment) => {
    const { Content } = await render(fragment);
    const spotifyEmbed = fragment.data.spotify
      ? parseSpotifyEmbed(fragment.data.spotify)
      : null;
    const youtubeId = fragment.data.youtube
      ? parseYoutubeId(fragment.data.youtube)
      : null;
    const videoUrl = fragment.data.video ?? null;
    return { fragment, Content, spotifyEmbed, youtubeId, videoUrl };
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Fragments - ${siteConfig.title}`}
      description="Short thoughts, small moments, and everything in between. Not quite a post, not quite a note. Just fragments."
    />
  </head>
  <body>
    <Header />

    <main>
      <div class="page-intro">
        <div class="eyebrow">Fragments</div>
        <h1>Life lately: <em>bits and pieces</em></h1>
        <p class="subtitle">
          Little fragments of my daily life, when I feel like sharing something
          short and cute.
        </p>
      </div>

      {
        fragments.length === 0 ? (
          <p class="empty-state">"Fragments are coming. Check back soon."</p>
        ) : (
          <div class="fragment-wall">
            {rendered.map(({ fragment, Content, spotifyEmbed, youtubeId, videoUrl }) => {
              const tagInfo = fragment.data.tag
                ? tagColors[fragment.data.tag]
                : null;
              const isQuote = !fragment.data.image && !videoUrl && !spotifyEmbed && !youtubeId;

              const cardMedia = spotifyEmbed ? (
                <div class="card-media card-media--spotify">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.516 17.314a.748.748 0 0 1-1.031.25c-2.824-1.725-6.376-2.115-10.564-1.158a.748.748 0 1 1-.334-1.458c4.583-1.049 8.517-.597 11.68 1.335a.748.748 0 0 1 .249 1.031zm1.472-3.27a.937.937 0 0 1-1.288.308c-3.231-1.985-8.157-2.56-11.977-1.401a.937.937 0 0 1-.545-1.793c4.363-1.325 9.786-.683 13.502 1.598a.937.937 0 0 1 .308 1.288zm.127-3.405C15.37 8.39 9.394 8.19 5.82 9.274a1.124 1.124 0 1 1-.653-2.151c4.114-1.249 10.952-1.008 15.265 1.574a1.124 1.124 0 1 1-1.317 1.942z" />
                  </svg>
                  <span class="card-media-label">Listening ♫</span>
                </div>
              ) : youtubeId ? (
                <div class="card-media card-media--youtube">
                  <img
                    src={`https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`}
                    alt=""
                    loading="lazy"
                  />
                  <div class="play-btn" aria-hidden="true">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              ) : videoUrl ? (
                <div class="card-media card-media--video">
                  <video
                    src={videoUrl}
                    class="card-video"
                    autoplay
                    muted
                    loop
                    playsinline
                  ></video>
                  <button
                    class="video-unmute-btn"
                    data-muted="true"
                    data-card-id={fragment.id}
                    aria-label="Unmute video"
                  >
                    <svg class="icon-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/>
                      <line x1="22" y1="9" x2="16" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <line x1="16" y1="9" x2="22" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <svg class="icon-sound" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/>
                      <path d="M15 8a5 5 0 0 1 0 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                    </svg>
                  </button>
                </div>
              ) : null;

              return (
                <div
                  class={`fragment-card${isQuote ? " fragment-card--quote" : ""}`}
                  role="button"
                  tabindex="0"
                  id={`frag-${fragment.id}`}
                  data-id={fragment.id}
                  data-tag={fragment.data.tag ?? ""}
                  data-tag-bg={tagInfo?.bg ?? ""}
                  data-tag-color={tagInfo?.color ?? ""}
                  data-emoji={fragment.data.emoji ?? ""}
                  data-video={videoUrl ?? ""}
                  aria-label="Open fragment"
                >
                  {fragment.data.image && (
                    <div class="card-image">
                      <Image
                        src={fragment.data.image}
                        alt=""
                        width={600}
                        height={600}
                        format="webp"
                        loading="lazy"
                      />
                    </div>
                  )}
                  {cardMedia}
                  <div class="card-body">
                    <div class="card-meta">
                      <time
                        datetime={fragment.data.date.toISOString()}
                        data-timestamp={fragment.data.date.toISOString()}
                      >
                        {fragment.data.date.toLocaleDateString("en-US", {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })}
                      </time>
                      {fragment.data.tag && tagInfo && (
                        <span
                          class="tag-pill"
                          style={`background: ${tagInfo.bg}; color: ${tagInfo.color};`}
                        >
                          {fragment.data.tag}
                        </span>
                      )}
                      {fragment.data.emoji && (
                        <span class="card-emoji">{fragment.data.emoji}</span>
                      )}
                    </div>
                    <div class="card-text">
                      <Content />
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }
    </main>

    <!-- Hidden content store: full-res images + rendered text, cloned into modal on open -->
    <div hidden aria-hidden="true">
      {
        rendered.map(({ fragment, Content, spotifyEmbed, youtubeId, videoUrl }) => (
          <div
            id={`store-${fragment.id}`}
            data-spotify-embed={spotifyEmbed ?? ""}
            data-youtube-id={youtubeId ?? ""}
            data-video={videoUrl ?? ""}
          >
            {fragment.data.image && (
              <div class="store-image">
                <Image
                  src={fragment.data.image}
                  alt=""
                  width={900}
                  height={900}
                  format="webp"
                  loading="lazy"
                />
              </div>
            )}
            <div class="store-date">
              <time
                datetime={fragment.data.date.toISOString()}
                data-timestamp={fragment.data.date.toISOString()}
              >
                {fragment.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
            </div>
            <div class="store-text">
              <Content />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Fragment modal -->
    <dialog id="fragment-modal" aria-label="Fragment detail" aria-modal="true">
      <!-- Close sits outside the scroll area so it never scrolls away -->
      <button class="modal-close" aria-label="Close">
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <line
            x1="2"
            y1="2"
            x2="14"
            y2="14"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></line>
          <line
            x1="14"
            y1="2"
            x2="2"
            y2="14"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></line>
        </svg>
      </button>

      <!-- Scrollable content area -->
      <div class="modal-scroll">
        <div class="modal-image-wrap" hidden></div>
        <div class="modal-media-wrap" hidden></div>

        <div class="modal-body">
          <div class="modal-meta">
            <span class="modal-date"></span>
            <span class="modal-tag" hidden></span>
            <span class="modal-emoji" hidden></span>
          </div>
          <div class="modal-text"></div>
          <div class="modal-actions">
            <div class="modal-nav">
              <button class="modal-prev" aria-label="Previous fragment">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <polyline points="10 3 4 8 10 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="modal-next" aria-label="Next fragment">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <polyline points="6 3 12 8 6 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            <button class="modal-share">
              <svg
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  cx="13"
                  cy="3"
                  r="2"
                  stroke="currentColor"
                  stroke-width="1.4"></circle>
                <circle
                  cx="13"
                  cy="13"
                  r="2"
                  stroke="currentColor"
                  stroke-width="1.4"></circle>
                <circle
                  cx="3"
                  cy="8"
                  r="2"
                  stroke="currentColor"
                  stroke-width="1.4"></circle>
                <line
                  x1="4.9"
                  y1="7.1"
                  x2="11.1"
                  y2="3.9"
                  stroke="currentColor"
                  stroke-width="1.4"></line>
                <line
                  x1="4.9"
                  y1="8.9"
                  x2="11.1"
                  y2="12.1"
                  stroke="currentColor"
                  stroke-width="1.4"></line>
              </svg>
              <span class="share-label">Share</span>
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <Footer />
  </body>
</html>

<script>
  // ── Relative time ──────────────────────────────────────────────────────────
  function relativeTime(isoString: string): string {
    const diff = Math.floor(
      (Date.now() - new Date(isoString).getTime()) / 1000,
    );
    if (diff < 60) return "just now";
    if (diff < 3600) {
      const m = Math.floor(diff / 60);
      return `${m} ${m === 1 ? "min" : "mins"} ago`;
    }
    if (diff < 86400) {
      const h = Math.floor(diff / 3600);
      return `${h} ${h === 1 ? "hour" : "hours"} ago`;
    }
    if (diff < 172800) return "yesterday";
    if (diff < 604800) {
      const d = Math.floor(diff / 86400);
      return `${d} days ago`;
    }
    // Older: show the actual date
    const date = new Date(isoString);
    const sameYear = date.getFullYear() === new Date().getFullYear();
    return date.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      ...(sameYear ? {} : { year: "numeric" }),
    });
  }

  function updateAllTimestamps() {
    document
      .querySelectorAll<HTMLTimeElement>("time[data-timestamp]")
      .forEach((el) => {
        const ts = el.dataset.timestamp!;
        el.textContent = relativeTime(ts);
        // Tooltip shows the exact datetime on hover
        el.title = new Date(ts).toLocaleString("en-US", {
          month: "long",
          day: "numeric",
          year: "numeric",
          hour: "numeric",
          minute: "2-digit",
        });
      });
  }

  updateAllTimestamps();
  setInterval(updateAllTimestamps, 60_000);

  // ── Video: card mute state ─────────────────────────────────────────────────
  let currentUnmutedCardId: string | null = null;

  function muteAllCardVideos() {
    document.querySelectorAll<HTMLVideoElement>(".card-video").forEach((v) => {
      v.muted = true;
    });
    document
      .querySelectorAll<HTMLElement>(".video-unmute-btn[data-card-id]")
      .forEach((btn) => {
        btn.dataset.muted = "true";
        btn.setAttribute("aria-label", "Unmute video");
      });
    currentUnmutedCardId = null;
  }

  // ── Modal ──────────────────────────────────────────────────────────────────
  const modal = document.getElementById("fragment-modal") as HTMLDialogElement;
  const modalImageWrap = modal.querySelector(
    ".modal-image-wrap",
  ) as HTMLElement;
  const modalMediaWrap = modal.querySelector(
    ".modal-media-wrap",
  ) as HTMLElement;
  const modalDate = modal.querySelector(".modal-date") as HTMLElement;
  const modalTag = modal.querySelector(".modal-tag") as HTMLElement;
  const modalEmoji = modal.querySelector(".modal-emoji") as HTMLElement;
  const modalText = modal.querySelector(".modal-text") as HTMLElement;
  const modalShare = modal.querySelector(".modal-share") as HTMLButtonElement;
  const modalScroll = modal.querySelector(".modal-scroll") as HTMLElement;
  const modalClose = modal.querySelector(".modal-close") as HTMLButtonElement;
  const modalPrev = modal.querySelector(".modal-prev") as HTMLButtonElement;
  const modalNext = modal.querySelector(".modal-next") as HTMLButtonElement;
  const shareLabel = modalShare.querySelector(".share-label") as HTMLElement;

  let currentId = "";
  let currentIndex = -1;

  // SVG icon strings for modal video controls (dynamically created, so defined as strings)
  const MUTED_ICON_SVG = `<svg class="icon-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/><line x1="22" y1="9" x2="16" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="16" y1="9" x2="22" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
  const SOUND_ICON_SVG = `<svg class="icon-sound" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/><path d="M15 8a5 5 0 0 1 0 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>`;
  const PAUSE_ICON_SVG = `<svg class="icon-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>`;
  const PLAY_ICON_SVG  = `<svg class="icon-play"  width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>`;

  function populateModal(card: HTMLElement) {
    const id = card.dataset.id!;
    currentId = id;

    const store = document.getElementById(`store-${id}`)!;

    // Image
    const storedImage = store.querySelector(".store-image");
    if (storedImage) {
      modalImageWrap.innerHTML = "";
      modalImageWrap.appendChild(storedImage.cloneNode(true));
      modalImageWrap.hidden = false;
    } else {
      modalImageWrap.hidden = true;
    }

    // Media: video > spotify > youtube
    const videoUrl = (store as HTMLElement).dataset.video;
    const spotifyEmbed = (store as HTMLElement).dataset.spotifyEmbed;
    const youtubeId = (store as HTMLElement).dataset.youtubeId;

    if (videoUrl) {
      const container = document.createElement("div");
      container.style.cssText = "position:relative;";

      const video = document.createElement("video");
      video.src = videoUrl;
      video.autoplay = true;
      video.muted = true;
      video.loop = true;
      video.setAttribute("playsinline", "");
      video.style.cssText =
        "display:block;width:100%;max-height:55vh;aspect-ratio:auto 16/9;object-fit:contain;background:#000;";

      const unmuteBtn = document.createElement("button");
      unmuteBtn.className = "video-unmute-btn";
      unmuteBtn.dataset.muted = "true";
      unmuteBtn.setAttribute("aria-label", "Unmute video");
      unmuteBtn.innerHTML = MUTED_ICON_SVG + SOUND_ICON_SVG;
      unmuteBtn.addEventListener("click", () => {
        video.muted = !video.muted;
        unmuteBtn.dataset.muted = video.muted ? "true" : "false";
        unmuteBtn.setAttribute(
          "aria-label",
          video.muted ? "Unmute video" : "Mute video",
        );
      });

      const pauseBtn = document.createElement("button");
      pauseBtn.className = "video-pause-btn";
      pauseBtn.dataset.playing = "true";
      pauseBtn.setAttribute("aria-label", "Pause video");
      pauseBtn.innerHTML = PAUSE_ICON_SVG + PLAY_ICON_SVG;
      pauseBtn.addEventListener("click", () => {
        if (video.paused) {
          video.play();
          pauseBtn.dataset.playing = "true";
          pauseBtn.setAttribute("aria-label", "Pause video");
        } else {
          video.pause();
          pauseBtn.dataset.playing = "false";
          pauseBtn.setAttribute("aria-label", "Play video");
        }
      });

      container.appendChild(video);
      container.appendChild(unmuteBtn);
      container.appendChild(pauseBtn);
      modalMediaWrap.innerHTML = "";
      modalMediaWrap.appendChild(container);
      modalMediaWrap.hidden = false;
    } else if (spotifyEmbed) {
      const iframe = document.createElement("iframe");
      iframe.src = spotifyEmbed;
      iframe.width = "100%";
      iframe.height = "152";
      iframe.allow =
        "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
      iframe.setAttribute("loading", "lazy");
      iframe.style.display = "block";
      iframe.style.border = "none";
      modalMediaWrap.innerHTML = "";
      modalMediaWrap.appendChild(iframe);
      modalMediaWrap.hidden = false;
    } else if (youtubeId) {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube.com/embed/${youtubeId}?autoplay=1`;
      iframe.width = "100%";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.setAttribute("loading", "lazy");
      iframe.style.display = "block";
      iframe.style.border = "none";
      iframe.style.aspectRatio = "16/9";
      modalMediaWrap.innerHTML = "";
      modalMediaWrap.appendChild(iframe);
      modalMediaWrap.hidden = false;
    } else {
      modalMediaWrap.innerHTML = "";
      modalMediaWrap.hidden = true;
    }

    // Date
    const storedDate = store.querySelector(".store-date")!;
    modalDate.innerHTML = storedDate.innerHTML;
    // Refresh relative time on the freshly cloned <time> element
    const modalTimeEl = modalDate.querySelector<HTMLTimeElement>(
      "time[data-timestamp]",
    );
    if (modalTimeEl) {
      const ts = modalTimeEl.dataset.timestamp!;
      modalTimeEl.textContent = relativeTime(ts);
      modalTimeEl.title = new Date(ts).toLocaleString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
        hour: "numeric",
        minute: "2-digit",
      });
    }

    // Tag
    const tag = card.dataset.tag;
    const tagBg = card.dataset.tagBg;
    const tagColor = card.dataset.tagColor;
    if (tag) {
      modalTag.textContent = tag;
      modalTag.setAttribute(
        "style",
        `background: ${tagBg}; color: ${tagColor};`,
      );
      modalTag.hidden = false;
    } else {
      modalTag.hidden = true;
    }

    // Emoji
    const emoji = card.dataset.emoji;
    if (emoji) {
      modalEmoji.textContent = emoji;
      modalEmoji.hidden = false;
    } else {
      modalEmoji.hidden = true;
    }

    // Text content
    const storedText = store.querySelector(".store-text")!;
    modalText.innerHTML = storedText.innerHTML;

    // Reset share button
    shareLabel.textContent = "Share";
    modalShare.disabled = false;

    modalScroll.scrollTop = 0;
  }

  function openModal(card: HTMLElement) {
    const scrollY = window.scrollY;
    currentIndex = masonryCards.indexOf(card);
    muteAllCardVideos();
    populateModal(card);
    updateNavButtons();
    // Lock page scroll so the background doesn't jump
    document.documentElement.style.overflow = "hidden";
    modal.showModal();
    // Restore scroll position in case showModal() moved it
    window.scrollTo(0, scrollY);
  }

  function closeModal() {
    document.documentElement.style.overflow = "";
    // Clear media iframes/videos so audio/video stops
    modalMediaWrap.innerHTML = "";
    modalMediaWrap.hidden = true;
    modal.close();
  }

  function updateNavButtons() {
    modalPrev.disabled = currentIndex <= 0;
    modalNext.disabled = currentIndex >= masonryCards.length - 1;
  }

  function navigateTo(index: number) {
    if (index < 0 || index >= masonryCards.length) return;
    currentIndex = index;
    populateModal(masonryCards[index]);
    updateNavButtons();
  }

  // Open on card click or keyboard activation
  document.querySelectorAll<HTMLElement>(".fragment-card").forEach((card) => {
    card.addEventListener("click", () => openModal(card));
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openModal(card);
      }
    });
  });

  // Card video unmute buttons — stopPropagation so the card click (open modal) doesn't fire
  document
    .querySelectorAll<HTMLButtonElement>(".video-unmute-btn[data-card-id]")
    .forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const cardId = btn.dataset.cardId!;
        const cardEl = document.getElementById(`frag-${cardId}`);
        const video = cardEl?.querySelector<HTMLVideoElement>(".card-video");
        if (!video) return;

        // Mute a different card that was previously unmuted
        if (currentUnmutedCardId && currentUnmutedCardId !== cardId) {
          const prevCard = document.getElementById(
            `frag-${currentUnmutedCardId}`,
          );
          const prevVideo =
            prevCard?.querySelector<HTMLVideoElement>(".card-video");
          const prevBtn =
            prevCard?.querySelector<HTMLElement>(".video-unmute-btn");
          if (prevVideo) prevVideo.muted = true;
          if (prevBtn) {
            prevBtn.dataset.muted = "true";
            prevBtn.setAttribute("aria-label", "Unmute video");
          }
          currentUnmutedCardId = null;
        }

        // Toggle this card
        video.muted = !video.muted;
        btn.dataset.muted = video.muted ? "true" : "false";
        btn.setAttribute(
          "aria-label",
          video.muted ? "Unmute video" : "Mute video",
        );
        currentUnmutedCardId = video.muted ? null : cardId;
      });
    });

  // Adapt card video tile to the video's actual aspect ratio (portrait vs landscape)
  document.querySelectorAll<HTMLVideoElement>(".card-video").forEach((video) => {
    const container = video.closest<HTMLElement>(".card-media--video");
    if (!container) return;

    const applyRatio = () => {
      if (video.videoWidth && video.videoHeight) {
        container.style.aspectRatio = `${video.videoWidth} / ${video.videoHeight}`;
        buildMasonryCols();
      }
    };

    // Metadata may already be available for cached videos
    if (video.readyState >= 1) {
      applyRatio();
    } else {
      video.addEventListener("loadedmetadata", applyRatio, { once: true });
    }
  });

  // Close on X button
  modalClose.addEventListener("click", closeModal);

  // Close on backdrop click (click outside modal-inner)
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Fires for both Escape key and closeModal() - always clean up overflow lock
  modal.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    shareLabel.textContent = "Share";
    modalShare.disabled = false;
  });

  // ── Round-robin masonry columns ──────────────────────────────────────────
  // CSS `columns` fills top-to-bottom then wraps (column-major order).
  // We want left-to-right then down (row-major), so we redistribute cards
  // into column divs in round-robin order via JS.
  const masonryWall = document.querySelector<HTMLElement>(".fragment-wall");
  const masonryCards = masonryWall
    ? Array.from(
        masonryWall.querySelectorAll<HTMLElement>(".fragment-card"),
      )
    : [];

  function buildMasonryCols(): void {
    if (!masonryWall || masonryCards.length === 0) return;
    const n =
      window.innerWidth > 1024 ? 3 : window.innerWidth >= 641 ? 2 : 1;

    masonryWall.innerHTML = "";

    if (n === 1) {
      masonryWall.style.cssText =
        "columns:unset;display:flex;flex-direction:column;gap:20px;";
      masonryCards.forEach((card) => {
        card.style.marginBottom = "0";
        masonryWall.appendChild(card);
      });
      return;
    }

    masonryWall.style.cssText =
      "columns:unset;display:flex;flex-direction:row;align-items:flex-start;gap:20px;";

    const colEls = Array.from({ length: n }, () => {
      const col = document.createElement("div");
      col.style.cssText =
        "flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:20px;";
      masonryWall.appendChild(col);
      return col;
    });

    const colHeights = new Array(n).fill(0);

    masonryCards.forEach((card) => {
      const shortest = colHeights.indexOf(Math.min(...colHeights));
      card.style.marginBottom = "0";
      colEls[shortest].appendChild(card);
      colHeights[shortest] += card.offsetHeight + 20;
    });
  }

  buildMasonryCols();

  let _colResizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(_colResizeTimer);
    _colResizeTimer = setTimeout(buildMasonryCols, 120);
  });

  // Prev / next button clicks
  modalPrev.addEventListener("click", () => navigateTo(currentIndex - 1));
  modalNext.addEventListener("click", () => navigateTo(currentIndex + 1));

  // Keyboard navigation (arrow keys, only when modal is open)
  window.addEventListener("keydown", (e) => {
    if (!modal.open) return;
    if (e.key === "ArrowLeft") navigateTo(currentIndex - 1);
    else if (e.key === "ArrowRight") navigateTo(currentIndex + 1);
  });

  // Touch swipe: left/right navigates; vertical motion still scrolls
  let _touchStartX = 0;
  let _touchStartY = 0;
  modal.addEventListener("touchstart", (e) => {
    _touchStartX = e.touches[0].clientX;
    _touchStartY = e.touches[0].clientY;
  }, { passive: true });
  modal.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - _touchStartX;
    const dy = e.changedTouches[0].clientY - _touchStartY;
    // Only fire if swipe is more horizontal than vertical and crosses threshold
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      if (dx < 0) navigateTo(currentIndex + 1); // swipe left → next
      else navigateTo(currentIndex - 1);         // swipe right → prev
    }
  }, { passive: true });

  // Share button
  modalShare.addEventListener("click", async () => {
    const url = `${window.location.origin}/fragments#frag-${currentId}`;

    if (navigator.share) {
      try {
        await navigator.share({ url });
      } catch {
        // User cancelled - do nothing
      }
    } else {
      await navigator.clipboard.writeText(url);
      shareLabel.textContent = "Copied!";
      modalShare.disabled = true;
      setTimeout(() => {
        shareLabel.textContent = "Share";
        modalShare.disabled = false;
      }, 2000);
    }
  });
</script>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 120px 60px 100px;
  }

  /* ── INTRO ── */
  .page-intro {
    text-align: center;
    margin-bottom: 56px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .eyebrow::before,
  .eyebrow::after {
    content: "";
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--color-terracotta);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  h1 em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  .subtitle {
    font-size: 0.92rem;
    color: var(--color-muted);
    font-weight: 300;
    line-height: 1.8;
    max-width: 680px;
    margin: 0 auto;
  }

  /* ── EMPTY STATE ── */
  .empty-state {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-muted);
    font-size: 1.1rem;
    padding: 60px 0;
  }

  /* ── MASONRY WALL ── */
  .fragment-wall {
    columns: 3;
    column-gap: 20px;
  }

  /* ── FRAGMENT CARD ── */
  .fragment-card {
    display: block;
    position: relative;
    container-type: inline-size; /* enables cqw units so children can reference the card's width */
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    text-align: left;
    width: 100%;
    box-sizing: border-box;
    /* Masonry: keep each card in one column, space below */
    break-inside: avoid;
    margin-bottom: 20px;
    /* Prevent text selection on click */
    user-select: none;
  }

  .fragment-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-terracotta);
    box-shadow:
      0 0 0 1px var(--color-terracotta),
      0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .fragment-card:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 2px;
  }

  /* Shine sweep - light catches the glass on hover */
  .fragment-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    pointer-events: none;
    z-index: 1;
  }

  .fragment-card:hover::before {
    animation: glass-shine 0.55s ease forwards;
  }

  @keyframes glass-shine {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(200%);
    }
  }

  .card-image {
    aspect-ratio: 1 / 1;
    background: rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-body {
    padding: 18px 20px 20px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .tag-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-emoji {
    font-size: 0.9rem;
    line-height: 1;
  }

  .card-text {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.8;
    font-weight: 300;
  }

  .card-text p {
    margin: 0;
  }
  .card-text p + p {
    margin-top: 0.75em;
  }

  /* ── QUOTE CARDS (text-only: no image, video, spotify, or youtube) ── */
  .fragment-card--quote {
    background: var(--color-card-bg);
    min-height: 140px;
  }

  /* ::before is the glass-shine hover sweep — quote mark uses ::after */
  .fragment-card--quote::after {
    content: '\201C';
    font-family: var(--font-serif);
    position: absolute;
    top: 4px;
    left: 14px;
    font-size: 5.5rem;
    line-height: 1;
    color: var(--color-ink);
    opacity: 0.07;
    pointer-events: none;
    z-index: 0;
  }

  .fragment-card--quote .card-body {
    position: relative;
    z-index: 1;
    padding: 22px 20px 22px;
  }

  .fragment-card--quote .card-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.9;
    color: var(--color-ink);
    font-weight: 400;
  }

  /* ── CARD MEDIA (Spotify / YouTube / Video) ── */
  .card-media {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  /* Spotify preview */
  .card-media--spotify {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: #121212;
    color: #1db954;
  }

  .card-media-label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #1db954;
  }

  /* YouTube thumbnail preview */
  .card-media--youtube {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .card-media--youtube img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-btn svg {
    width: 44px;
    height: 44px;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 50%;
    padding: 10px;
    color: #fff;
    transition: background 0.15s;
  }

  .fragment-card:hover .play-btn svg {
    background: rgba(0, 0, 0, 0.75);
  }

  /* Video preview */
  .card-media--video {
    position: relative;
    width: 100%; /* explicit width prevents the browser from shrinking it when aspect-ratio × max-height conflict */
    aspect-ratio: 16 / 9;
    max-height: 100cqw; /* same cap as photo tile (1:1 = height equals card width) */
    background: #000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── MUTE / UNMUTE + PAUSE / PLAY BUTTONS (card + modal) ──
     :global() is required because the modal buttons are created via document.createElement
     and never receive Astro's scoped data attribute. */
  :global(.video-unmute-btn),
  :global(.video-pause-btn) {
    position: absolute;
    bottom: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    z-index: 2;
    padding: 0;
    transition: background 0.15s;
  }

  :global(.video-unmute-btn) { right: 10px; }
  :global(.video-pause-btn)  { left: 10px;  }

  :global(.video-unmute-btn:hover),
  :global(.video-pause-btn:hover) {
    background: rgba(0, 0, 0, 0.85);
  }

  /* Show only the relevant icon based on state */
  :global(.video-unmute-btn[data-muted="true"]   .icon-sound) { display: none; }
  :global(.video-unmute-btn[data-muted="false"]  .icon-muted) { display: none; }
  :global(.video-pause-btn[data-playing="true"]  .icon-play)  { display: none; }
  :global(.video-pause-btn[data-playing="false"] .icon-pause) { display: none; }

  /* ── MODAL ── */
  #fragment-modal {
    /* Fix: position:fixed with inset:0 + margin:auto centers on the viewport,
       not the document. This means the modal never causes the page to scroll
       and is always centered regardless of where the user has scrolled to.
       position:fixed also acts as the containing block for .modal-close (position:absolute). */
    position: fixed;
    inset: 0;
    margin: auto;
    height: fit-content; /* don't stretch to fill viewport height */

    padding: 0;
    border: none;
    border-radius: 14px;

    /* Width: content-driven up to the desktop max */
    width: min(68vw, 720px);

    /* No max-height here: let .modal-scroll own that so overflow-y actually works */
    overflow: hidden; /* clips children to border-radius */

    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    background: #fff;
  }

  #fragment-modal::backdrop {
    background: rgba(20, 16, 12, 0.48);
    backdrop-filter: blur(4px);
  }

  #fragment-modal[open] {
    animation: modal-in 0.2s ease both;
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Close button - fixed to top-right corner, never scrolls away */
  .modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-ink-soft);
    transition:
      color 0.15s,
      background 0.15s;
  }

  .modal-close:hover {
    color: var(--color-ink);
    background: #fff;
  }

  /* Scrollable content - this is the only element that scrolls */
  .modal-scroll {
    overflow-y: auto;
    max-height: 82vh;
    display: flex;
    flex-direction: column;
  }

  /* Image: height is driven by the image itself, capped so tall portraits don't overflow */
  .modal-image-wrap {
    flex-shrink: 0;
    background: #f7f5f2;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
    /* Center the image if it's narrower than the modal */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 52vh; /* cap tall portraits; landscape images will be shorter */
    object-fit: contain;
    background: #f7f5f2; /* letterbox color for contain */
  }

  /* Spotify / YouTube / Video embed container */
  .modal-media-wrap {
    flex-shrink: 0;
    border-bottom: 1px solid var(--color-border);
    background: #000;
    overflow: hidden;
  }

  /* Spotify iframe height is fixed at 152px; YouTube/video uses aspect-ratio set inline */
  .modal-media-wrap iframe {
    display: block;
    width: 100%;
    border: none;
  }

  .modal-body {
    padding: 22px 24px 26px;
  }

  .modal-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
    font-size: 0.74rem;
    color: var(--color-muted);
  }

  .modal-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modal-emoji {
    font-size: 1rem;
    line-height: 1;
  }

  .modal-text {
    font-size: 0.93rem;
    color: var(--color-ink-soft);
    line-height: 1.85;
    font-weight: 300;
  }

  .modal-text p {
    margin: 0;
  }
  .modal-text p + p {
    margin-top: 0.85em;
  }

  .modal-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }

  .modal-nav {
    display: flex;
    gap: 6px;
  }

  .modal-prev,
  .modal-next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-ink-soft);
    transition: border-color 0.15s, color 0.15s;
  }

  .modal-prev:hover:not(:disabled),
  .modal-next:hover:not(:disabled) {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta);
  }

  .modal-prev:disabled,
  .modal-next:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .modal-share {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.77rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .modal-share:hover {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta);
  }

  .modal-share:disabled {
    border-color: #7a9e7e;
    color: #7a9e7e;
    cursor: default;
  }

  /* ── TABLET ── */
  @media (max-width: 1024px) and (min-width: 641px) {
    .fragment-wall {
      columns: 2;
    }

    #fragment-modal {
      width: min(82vw, 680px);
    }
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    main {
      padding: 100px 20px 80px;
    }

    .fragment-wall {
      columns: 1;
    }

    #fragment-modal {
      width: calc(100% - 24px);
    }

    .modal-image-wrap img {
      max-height: 40vh;
    }

    .modal-scroll {
      max-height: 90vh;
    }
  }
</style>
