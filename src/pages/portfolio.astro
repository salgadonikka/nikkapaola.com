---
import { Image } from "astro:assets";
import portfolioPhoto from "../assets/portfolio-photo.png";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE } from "../consts";

const sections = [
  { num: "01", label: "Introduction", id: "tile-01" },
  { num: "02", label: "Experience",   id: "tile-02" },
  { num: "03", label: "Contact",      id: "tile-03" },
];
---

<!doctype html>
<html lang="en" class="pf2-html">
  <head>
    <BaseHead
      title={`Portfolio — ${SITE_TITLE}`}
      description="Full-Stack Software Engineer with 11+ years of experience in .NET and React. Based in the Philippines, open to roles in Poland and Europe."
    />
    <style is:global>
      @media (min-width: 769px) {
        html.pf2-html,
        html.pf2-html body {
          overflow: hidden;
          height: 100%;
        }
      }
    </style>
  </head>

  <body>
    <!-- ── MOBILE TOP BAR ── -->
    <div class="mob-bar" id="mob-bar">
      <a href="/" class="mob-monogram">NPS</a>
      <button
        class="mob-hamburger"
        id="mob-hamburger"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- ── MOBILE OVERLAY ── -->
    <div class="mob-overlay" id="mob-overlay" aria-hidden="true">
      <button class="mob-close" id="mob-close" aria-label="Close navigation"
        >✕</button
      >
      <nav class="mob-nav-list">
        {
          sections.map((s) => (
            <a href={`#${s.id}`} class="mob-nav-link" data-section={s.num}>
              <span class="mob-nav-num">{s.num}</span>
              <span class="mob-nav-label">{s.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="mob-overlay-foot">
        <div class="mob-avail">
          <span class="pulse-dot"></span>
          Open to work · Poland &amp; Europe
        </div>
        <div class="mob-contact-links">
          <a href="mailto:nikkapfs@gmail.com">nikkapfs@gmail.com</a>
          <a
            href="https://linkedin.com/in/nikkasalgado"
            target="_blank"
            rel="noopener">linkedin.com/in/nikkasalgado</a
          >
          <a
            href="https://github.com/salgadonikka"
            target="_blank"
            rel="noopener">github.com/salgadonikka</a
          >
        </div>
        <a href="/" class="mob-site-back">← Back to nikkapaola.com</a>
      </div>
    </div>

    <!-- ══ MOBILE IDENTITY STRIP (hidden on desktop) ══ -->
    <div class="mob-identity" aria-hidden="true">
      <div class="mob-identity-name">Nikka Paola Salgado</div>
      <div class="mob-identity-role">Full-Stack Software Engineer &amp; People Manager</div>
    </div>

    <!-- ══ MAIN LAYOUT ══ -->
    <div class="pf2-layout">
      <!-- ══════ LEFT SIDEBAR ══════ -->
      <aside
        class="pf2-sidebar"
        id="pf2-sidebar"
        aria-label="Portfolio navigation"
      >
        <div class="si-rule"></div>
        <div class="si-inner">
          <!-- ── Identity ── -->
          <div class="si-top">
            <div class="si-avatar">
              <Image
                src={portfolioPhoto}
                alt="Nikka Salgado"
                width={100}
                height={100}
                class="si-avatar-img"
              />
              <span class="si-avatar-fallback" aria-hidden="true">NPS</span>
            </div>
            <div class="si-mono-rule"></div>
            <div class="si-name">Nikka Paola Salgado</div>
            <div class="si-role">Full-Stack Software Engineer</div>
            <div class="si-stack">.NET · React · Azure</div>
          </div>

          <!-- ── Status + Contacts ── -->
          <div class="si-bottom">
            <div class="si-avail">
              <span class="pulse-dot"></span>
              <span class="si-avail-text">Open to work</span>
            </div>
            <div class="si-location">Poland &amp; Europe · Remote / Hybrid</div>
            <div class="si-divider"></div>
            <div class="si-contacts">
              <a
                href="mailto:nikkapfs@gmail.com"
                class="si-contact-link"
                title="Email"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect
                    x="1"
                    y="3"
                    width="14"
                    height="10"
                    rx="1.5"
                    stroke="currentColor"
                    stroke-width="1.3"></rect>
                  <path
                    d="M1 4.5 8 9.5l7-5"
                    stroke="currentColor"
                    stroke-width="1.3"></path>
                </svg>
                <span>nikkapfs@gmail.com</span>
              </a>
              <a
                href="https://linkedin.com/in/nikkasalgado"
                target="_blank"
                rel="noopener"
                class="si-contact-link"
                title="LinkedIn"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M3.4 5.3H1V15h2.4V5.3zM2.2 4.2a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8zM5.7 5.3V15H8V10c0-2.2 2.9-2.4 2.9 0V15H13.3V9.2c0-4.4-4.6-4.2-5.3-2.1V5.3H5.7z"
                  ></path>
                </svg>
                <span>linkedin.com/in/nikkasalgado</span>
              </a>
              <a
                href="https://github.com/salgadonikka"
                target="_blank"
                rel="noopener"
                class="si-contact-link"
                title="GitHub"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M8 .5C3.86.5.5 3.86.5 8a7.5 7.5 0 0 0 5.14 7.12c.38.07.52-.16.52-.36v-1.27c-2.1.46-2.54-.9-2.54-.9-.34-.87-.84-1.1-.84-1.1-.69-.47.05-.46.05-.46.76.05 1.16.78 1.16.78.67 1.16 1.76.82 2.19.63.07-.49.26-.82.48-1.01-1.67-.19-3.43-.84-3.43-3.72 0-.82.29-1.49.78-2.02-.08-.2-.34-1 .07-2.07 0 0 .64-.2 2.09.78A7.27 7.27 0 0 1 8 4.74a7.27 7.27 0 0 1 1.9.26c1.45-.98 2.09-.78 2.09-.78.41 1.07.15 1.87.07 2.07.49.53.78 1.2.78 2.02 0 2.89-1.76 3.53-3.44 3.72.27.24.51.7.51 1.4v2.08c0 .2.14.44.52.36A7.5 7.5 0 0 0 15.5 8C15.5 3.86 12.14.5 8 .5z"
                  ></path>
                </svg>
                <span>github.com/salgadonikka</span>
              </a>
              <a
                href="https://nikkapaola.com"
                class="si-contact-link"
                title="Website"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle
                    cx="8"
                    cy="8"
                    r="6.5"
                    stroke="currentColor"
                    stroke-width="1.3"></circle>
                  <path
                    d="M8 1.5c-1.5 2-2.5 4-2.5 6.5s1 4.5 2.5 6.5M8 1.5c1.5 2 2.5 4 2.5 6.5S9.5 12.5 8 14.5M1.5 8h13"
                    stroke="currentColor"
                    stroke-width="1.3"></path>
                </svg>
                <span>nikkapaola.com</span>
              </a>
              <a
                href="/resume.pdf"
                target="_blank"
                rel="noopener"
                class="si-contact-link si-contact-link--resume"
                title="Resume"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M8 2v8M5 7l3 3 3-3M2 13h12"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <span>View my Resume</span>
              </a>
            </div>

            <!-- ── Navigation ── -->
            <div class="si-divider"></div>
            <nav class="si-nav" aria-label="Portfolio sections">
              {
                sections.map((s, i) => (
                  <a
                    href={`#${s.id}`}
                    class={`si-link${i === 0 ? " si-link--active" : ""}`}
                    data-section={s.num}
                    aria-current={i === 0 ? "true" : "false"}
                  >
                    <span class="si-num">{s.num}</span>
                    <span class="si-label">{s.label}</span>
                  </a>
                ))
              }
            </nav>
            <a href="/" class="si-back">← Back to site</a>
          </div>
        </div>
      </aside>

      <!-- ══════ RIGHT PANEL ══════ -->
      <main class="pf2-right" id="pf2-right" tabindex="-1">
        <!-- ─── TILE 01 — INTRODUCTION + SKILLS ─── -->
        <section
          class="tile"
          id="tile-01"
          data-section="01"
          aria-label="Introduction"
        >
          <div class="tile-inner t01">
            <div class="t01-grid">
              <!-- Left column: role, location, prose, stats -->
              <div class="t01-left">
                <h1 class="t01-role">
                  Full-Stack Software Engineer<br />&amp; People Manager
                </h1>
                <!--
                <p class="t01-location">
                  Philippines → Poland &amp; Europe<br />Remote-friendly ·
                  Hybrid
                </p>-->
                <div class="t01-prose">
                  <p>
                    I am a full-stack software engineer with 11+ years of
                    experience delivering end-to-end web applications using .NET
                    and modern front-end frameworks. I specialize in building
                    systems that are not just functional, but maintainable,
                    performant, and ready for real-world scale. From
                    architecture to deployment, I focus on writing clean,
                    sustainable code while ensuring the systems I build can
                    evolve with the business.
                  </p>
                  <p>
                    Looking for a mid-level engineering role in Poland or Europe.
                  </p>
                </div>
                <div class="t01-data-col">
                  <div class="t01-data-row">
                    <span class="t01-data-num">What I bring</span>
                    <span class="t01-data-label"></span>
                  </div>
                  <div class="t01-data-row">
                    <span class="t01-data-num"></span>
                    <span class="t01-data-label"
                      >End-to-end system ownership (design → deployment)</span
                    >
                  </div>
                  <div class="t01-data-row">
                    <span class="t01-data-num"></span>
                    <span class="t01-data-label"
                      >Strong backend architecture and API design</span
                    >
                  </div>
                  <div class="t01-data-row">
                    <span class="t01-data-num"></span>
                    <span class="t01-data-label"
                      >Modern frontend development (React, Blazor)</span
                    >
                  </div>
                  <div class="t01-data-row">
                    <span class="t01-data-num"></span>
                    <span class="t01-data-label"
                      >Experience leading teams and delivering features</span
                    >
                  </div>
                </div>
              </div>

              <!-- Right column: skills & stack -->
              <div class="t01-skills">
                <div class="tile-label">Skills &amp; Stack</div>
                <div class="t01-skill-groups">
                  <div class="skill-group">
                    <div class="sg-label">Backend &amp; API</div>
                    <div class="badge-row">
                      <span class="bp">C# .NET 6–8</span><span class="bp"
                        >ASP.NET Core</span
                      >
                      <span class="bp">Web API</span><span class="bp"
                        >RESTful APIs</span
                      >
                      <span class="bp">OAuth2 / OIDC</span><span class="bp"
                        >Entity Framework</span
                      >
                      <span class="bp">LINQ</span><span class="bs"
                        >NUnit / xUnit</span
                      >
                    </div>
                  </div>
                  <div class="skill-group">
                    <div class="sg-label">Frontend</div>
                    <div class="badge-row">
                      <span class="bp">React</span><span class="bp"
                        >TypeScript</span
                      >
                      <span class="bp">JavaScript</span><span class="bp"
                        >HTML5</span
                      >
                      <span class="bp">CSS3</span><span class="bs"
                        >Responsive Design</span
                      >
                    </div>
                  </div>
                  <div class="skill-group">
                    <div class="sg-label">Data &amp; Cloud</div>
                    <div class="badge-row">
                      <span class="bp">Azure</span><span class="bp"
                        >SQL Server</span
                      >
                      <span class="bp">PostgreSQL</span><span class="bp"
                        >Azure DevOps</span
                      >
                      <span class="bp">CI/CD</span><span class="bs">Docker</span
                      >
                      <span class="bs">SSIS / SSRS</span>
                    </div>
                  </div>
                  <div class="skill-group">
                    <div class="sg-label">Practices</div>
                    <div class="badge-row">
                      <span class="bp">SOLID</span><span class="bp"
                        >Code Reviews</span
                      >
                      <span class="bp">Unit Testing</span><span class="bp"
                        >Agile / Scrum</span
                      >
                      <span class="bs">Selenium</span><span class="bs"
                        >GitHub Copilot</span
                      >
                    </div>
                  </div>
                  <div class="skill-group">
                    <div class="sg-label">Leadership</div>
                    <div class="badge-row">
                      <span class="bl">People Management</span>
                      <span class="bl">Mentoring</span>
                      <span class="bl">Remote Team Coordination</span>
                      <span class="bl">Stakeholder Communication</span>
                    </div>
                  </div>
                </div>
                <div class="learning-callout">
                  <div class="learning-lbl">Currently deepening</div>
                  <div class="learning-tags">
                    <span>CQRS</span><span>MediatR</span><span>Docker</span>
                    <span>AZ-204</span><span>Distributed systems</span>
                    <span>Polish (A1)</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ─── TILE 02 — EXPERIENCE + FEATURED WORK ─── -->
        <section
          class="tile tile--alt"
          id="tile-02"
          data-section="02"
          aria-label="Experience and Work"
        >
          <div class="tile-inner t02">
            <div class="t02-grid">
              <!-- Left column: experience timeline -->
              <div class="t02-left">
                <div class="tile-label">Experience</div>
                <h2 class="t02-heading">Career Timeline</h2>
                <div class="timeline">

                  <!-- WTW -->
                  <div
                    class="tl-entry"
                    data-drawer="wtw"
                    role="button"
                    tabindex="0"
                    aria-label="View WTW details"
                  >
                    <div class="tl-dot"></div>
                    <div class="tl-date">Feb 2019 — Present</div>
                    <div class="tl-company">WTW Manila Global Delivery Center</div>
                    <div class="tl-role-group">
                      <div class="tl-role">Lead Associate Software Engineer</div>
                      <div class="tl-role-sub">& People Manager</div>
                      <div class="tl-promotion">Started as Associate Software Engineer · Promoted Apr 2024</div>
                    </div>
                    <p class="tl-desc">Full-stack development on enterprise benefits platforms serving 100+ global clients. Promoted to lead; concurrently managing a distributed engineering team.</p>
                    <div class="tl-stack">ASP.NET Core · React · SQL Server · Azure DevOps</div>
                  </div>

                  <!-- Deltek -->
                  <div
                    class="tl-entry"
                    data-drawer="deltek"
                    role="button"
                    tabindex="0"
                    aria-label="View Deltek details"
                  >
                    <div class="tl-dot"></div>
                    <div class="tl-date">Jan 2016 — Jan 2019</div>
                    <div class="tl-company">Deltek Systems (Philippines)</div>
                    <div class="tl-role">Software Engineer</div>
                    <p class="tl-desc">Built internal R&amp;D tools (SSO, Test Results Manager) and maintained Test Runner — an automation framework used across the majority of Deltek's products.</p>
                    <div class="tl-stack">C# · .NET Framework · Selenium · SQL Server</div>
                  </div>

                  <!-- EastWest -->
                  <div
                    class="tl-entry"
                    data-drawer="eastwest"
                    role="button"
                    tabindex="0"
                    aria-label="View EastWest details"
                  >
                    <div class="tl-dot"></div>
                    <div class="tl-date">Jul 2012 — Jan 2016</div>
                    <div class="tl-company">EastWest Banking Corporation</div>
                    <div class="tl-role-group">
                      <div class="tl-role">Programmer/Analyst — Assistant Manager</div>
                      <div class="tl-promotion">Started as IT Management Trainee · Promoted Jan 2015</div>
                    </div>
                    <p class="tl-desc">Core banking transformation project (Phoenix → Temenos T24) and compliance-critical internal tooling for banking operations.</p>
                    <div class="tl-stack">C# · .NET Framework · SQL Server · Temenos T24 · jBase</div>
                  </div>

                  <!-- Emerson -->
                  <div
                    class="tl-entry"
                    data-drawer="emerson"
                    role="button"
                    tabindex="0"
                    aria-label="View Emerson internship details"
                  >
                    <div class="tl-dot tl-dot--muted"></div>
                    <div class="tl-date tl-date--muted">Apr 2012 — Jun 2012</div>
                    <div class="tl-company tl-company--muted">Emerson Process Management</div>
                    <div class="tl-role tl-role--muted">Software Developer Intern</div>
                    <p class="tl-desc tl-desc--muted">Built a Windows app interfacing with an Arduino device and a mobile chat app for Android.</p>
                    <div class="tl-stack tl-stack--muted">C# · Java (Android) · Arduino</div>
                  </div>

                  <!-- Mapua -->
                  <div
                    class="tl-entry"
                    data-drawer="mapua"
                    role="button"
                    tabindex="0"
                    aria-label="View education details"
                  >
                    <div class="tl-dot tl-dot--muted"></div>
                    <div class="tl-date tl-date--muted">Jul 2007 — Aug 2012</div>
                    <div class="tl-company tl-company--muted">Mapua Institute of Technology</div>
                    <div class="tl-role tl-role--muted">B.S. Computer Engineering</div>
                    <p class="tl-desc tl-desc--muted">Specialization in Microsoft .NET Framework. Thesis: Web-based Blood Pressure and ECG Monitoring System.</p>
                  </div>

                </div>
              </div>

              <!-- Right column: featured work -->
              <div class="t02-right">
                <div class="tile-label">Featured Work</div>

                <div
                  class="fc-card"
                  data-drawer="benefits-platform"
                  role="button"
                  tabindex="0"
                  aria-label="View project details"
                >
                  <div class="fc-eyebrow">Enterprise Case Study</div>
                  <div class="fc-head">
                    <div>
                      <h2 class="fc-title">Benefits Outsourcing Platform</h2>
                      <p class="fc-company">
                        WTW Manila Global Delivery Center
                      </p>
                    </div>
                  </div>
                  <p class="fc-desc">
                    Enterprise React + .NET platform for pension and health
                    clients globally. More details too be updated soon.
                  </p>
                  <div class="fc-stack">
                    ASP.NET Core · React · SQL Server · Azure DevOps
                  </div>
                  <span class="card-more" aria-hidden="true"
                    >View case study →</span
                  >
                </div>

                <div class="proj-grid">
                  <div
                    class="proj-card"
                    data-drawer="tamelo"
                    role="button"
                    tabindex="0"
                    aria-label="View Tamelo details"
                  >
                    <div class="proj-head">
                      <div class="proj-title">Tamelo App &amp; API</div>
                    </div>
                    <p class="proj-desc">
                      A weekly task planner mapping tasks to days using circular
                      state indicators across a rolling 7-day calendar.
                    </p>
                    <div class="proj-stack">
                      React 18 · TypeScript · ASP.NET Core 10 · Supabase
                    </div>
                    <span class="card-more" aria-hidden="true"
                      >View details →</span
                    >
                  </div>
                  <div
                    class="proj-card"
                    data-drawer="mymedstory"
                    role="button"
                    tabindex="0"
                    aria-label="View MyMedStory details"
                  >
                    <div class="proj-head">
                      <div class="proj-title">MyMedStory</div>
                    </div>
                    <p class="proj-desc">
                      Personal health intelligence platform transforming
                      scattered medical records into a unified, AI-assisted
                      timeline.
                    </p>
                    <div class="proj-stack">
                      .NET 8 · Next.js 14 · React Native · Cloudflare R2
                    </div>
                    <span class="card-more" aria-hidden="true"
                      >View details →</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ─── TILE 03 — CONTACT ─── -->
        <section
          class="tile tile--dark"
          id="tile-03"
          data-section="03"
          aria-label="Contact"
        >
          <div class="tile-inner t03c">

            <!-- Photo + identity (animated in) -->
            <div class="t03c-hero" id="t03c-hero">
              <div class="t03c-photo-wrap" id="t03c-photo-wrap">
                <Image
                  src={portfolioPhoto}
                  alt="Nikka Paola Salgado"
                  width={300}
                  height={300}
                  class="t03c-photo"
                />
              </div>
              <div class="t03c-identity" id="t03c-identity">
                <div class="t03c-name">Nikka Paola Salgado</div>
                <div class="t03c-role">Full-Stack Software Engineer &amp; People Manager</div>
                <div class="t03c-stack">.NET · React · Azure</div>
                <div class="t03c-avail">
                  <span class="pulse-dot"></span>
                  Available for new roles · Poland &amp; Europe
                </div>
              </div>
            </div>

            <!-- Heading + body -->
            <div class="t03c-copy" id="t03c-copy">
              <h2 class="t03c-heading">Let's work together.</h2>
              <p class="t03c-body">I'm actively looking for mid-level .NET full-stack roles in Poland and Europe. Remote or hybrid. If you're hiring, or just want to talk engineering, I'd love to hear from you.</p>
            </div>

            <!-- Contact links with icons -->
            <div class="t03c-links" id="t03c-links">
              <a href="mailto:nikkapfs@gmail.com" class="t03c-link">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M1 4.5 8 9.5l7-5" stroke="currentColor" stroke-width="1.3"/>
                </svg>
                <span>nikkapfs@gmail.com</span>
              </a>
              <a href="https://linkedin.com/in/nikkasalgado" target="_blank" rel="noopener" class="t03c-link">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M3.4 5.3H1V15h2.4V5.3zM2.2 4.2a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8zM5.7 5.3V15H8V10c0-2.2 2.9-2.4 2.9 0V15H13.3V9.2c0-4.4-4.6-4.2-5.3-2.1V5.3H5.7z"/>
                </svg>
                <span>linkedin.com/in/nikkasalgado</span>
              </a>
              <a href="https://github.com/salgadonikka" target="_blank" rel="noopener" class="t03c-link">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
