---
import { Image } from 'astro:assets';
import portfolioPhoto from '../assets/portfolio-photo.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Portfolio — ${SITE_TITLE}`}
      description="Full-Stack Software Engineer with 11+ years of experience in .NET and React. Based in the Philippines, open to roles in Poland and Europe."
    />
  </head>
  <body>
    <Header />

    <!-- ── PORTFOLIO SECTION NAV ── -->
    <nav class="pf-nav" aria-label="Portfolio sections">
      <div class="pf-nav-inner">
        <a href="#about"      class="pf-nav-link">About</a>
        <a href="#skills"     class="pf-nav-link">Skills</a>
        <a href="#experience" class="pf-nav-link">Experience</a>
        <a href="#projects"   class="pf-nav-link">Projects</a>
        <a href="#contact"    class="pf-nav-link">Contact</a>
      </div>
    </nav>

    <main id="pf-main">

      <!-- ══════════════════════════════════
           HERO / ABOUT
      ══════════════════════════════════ -->
      <section id="about" class="pf-section hero-section">
        <div class="container">
          <div class="hero-grid" data-animate>

            <div class="hero-left">
              <div class="availability-badge">
                <span class="pulse-dot"></span>
                Open to work · Poland &amp; Europe
              </div>

              <h1 class="hero-name">Nikka Salgado</h1>
              <p class="hero-subtitle">Full-Stack Software Engineer · <em>.NET · React</em></p>

              <p class="hero-bio">
                Hello! I'm Nikka Salgado, a Full-Stack Software Engineer currently based in the
                Philippines, actively pursuing opportunities in Poland and Europe (remote-friendly
                or hybrid).
              </p>
              <p class="hero-bio">
                I have 11+ years of professional experience building enterprise web applications
                using .NET and React, delivering across fintech, SaaS, and automation. Most
                recently, I served as a Software Engineer and People Manager at WTW Manila Global
                Delivery Center, contributing to Benefits Outsourcing platforms for pension and
                health clients across 100+ global organisations.
              </p>

              <div class="hero-cta">
                <a href="#projects" class="btn-primary">View my work</a>
                <a href="#contact"  class="btn-ghost">Get in touch</a>
              </div>
            </div>

            <div class="hero-right">
              <div class="avatar-circle">
                <Image
                  src={portfolioPhoto}
                  alt="Nikka Salgado"
                  width={200}
                  height={200}
                  class="avatar-photo"
                />
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════
           SKILLS
      ══════════════════════════════════ -->
      <section id="skills" class="pf-section skills-section">
        <div class="container">

          <header class="section-header" data-animate>
            <div class="section-eyebrow">What I work with</div>
            <h2 class="section-title">Skills &amp; <em>Tech Stack</em></h2>
          </header>

          <div class="skills-grid">

            <div class="skill-group" data-animate>
              <h3 class="skill-group-label">Backend &amp; API</h3>
              <div class="skill-tags">
                <span class="stag stag--primary">C#</span>
                <span class="stag stag--primary">.NET 6–8</span>
                <span class="stag stag--primary">ASP.NET Core</span>
                <span class="stag stag--primary">Web API</span>
                <span class="stag stag--primary">RESTful APIs</span>
                <span class="stag stag--primary">OOP &amp; Design Patterns</span>
                <span class="stag stag--primary">OAuth2 / OpenID Connect</span>
                <span class="stag stag--primary">Entity Framework Core</span>
                <span class="stag stag--primary">LINQ</span>
                <span class="stag stag--primary">NUnit / xUnit</span>
              </div>
            </div>

            <div class="skill-group" data-animate data-animate-delay="60">
              <h3 class="skill-group-label">Frontend</h3>
              <div class="skill-tags">
                <span class="stag stag--primary">React</span>
                <span class="stag stag--primary">TypeScript</span>
                <span class="stag stag--primary">JavaScript (ES6+)</span>
                <span class="stag stag--primary">HTML5</span>
                <span class="stag stag--primary">CSS3</span>
                <span class="stag stag--primary">Responsive Design</span>
              </div>
            </div>

            <div class="skill-group" data-animate data-animate-delay="120">
              <h3 class="skill-group-label">Data &amp; Cloud</h3>
              <div class="skill-tags">
                <span class="stag stag--primary">Azure</span>
                <span class="stag stag--primary">SQL Server</span>
                <span class="stag stag--primary">PostgreSQL</span>
                <span class="stag stag--primary">Azure DevOps</span>
                <span class="stag stag--primary">CI/CD Pipelines</span>
                <span class="stag stag--primary">Git</span>
                <span class="stag stag--secondary">Docker</span>
                <span class="stag stag--secondary">SSIS / SSRS</span>
              </div>
            </div>

            <div class="skill-group" data-animate data-animate-delay="60">
              <h3 class="skill-group-label">Practices &amp; Tooling</h3>
              <div class="skill-tags">
                <span class="stag stag--primary">SOLID Principles</span>
                <span class="stag stag--primary">Code Reviews</span>
                <span class="stag stag--primary">Unit &amp; Integration Testing</span>
                <span class="stag stag--primary">Agile / Scrum</span>
                <span class="stag stag--secondary">Selenium</span>
                <span class="stag stag--secondary">GitHub Copilot</span>
                <span class="stag stag--secondary">API Integrations</span>
              </div>
            </div>

            <div class="skill-group skill-group--wide" data-animate data-animate-delay="120">
              <h3 class="skill-group-label">Leadership &amp; Soft Skills</h3>
              <div class="skill-tags">
                <span class="stag stag--secondary">Technical Leadership</span>
                <span class="stag stag--secondary">People Management</span>
                <span class="stag stag--secondary">Mentoring &amp; Coaching</span>
                <span class="stag stag--secondary">Cross-functional Collaboration</span>
                <span class="stag stag--secondary">Remote Team Coordination</span>
                <span class="stag stag--secondary">Stakeholder Communication</span>
                <span class="stag stag--secondary">Architecture Guidance</span>
              </div>
            </div>

          </div>

          <div class="learning-callout" data-animate data-animate-delay="80">
            <div class="learning-icon">🌱</div>
            <div class="learning-body">
              <div class="learning-label">Currently learning</div>
              <p class="learning-items">
                CQRS &amp; MediatR patterns
                <span class="sep">·</span>
                Docker &amp; container orchestration
                <span class="sep">·</span>
                Azure Developer (AZ-204)
                <span class="sep">·</span>
                Distributed systems design
                <span class="sep">·</span>
                Polish (A1)
              </p>
            </div>
          </div>

        </div>
      </section>

      <!-- ══════════════════════════════════
           EXPERIENCE
      ══════════════════════════════════ -->
