    </main>

    <Footer />

    <script is:inline>
      // ── SCROLL-TRIGGERED FADE-IN ──
      const animObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const delay = Number(entry.target.dataset.animateDelay ?? 0);
              setTimeout(() => entry.target.classList.add('is-visible'), delay);
              animObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('[data-animate]').forEach((el) => animObserver.observe(el));

      // ── ACTIVE SECTION HIGHLIGHT IN SUB-NAV ──
      const pfSections = document.querySelectorAll('.pf-section');
      const pfNavLinks = document.querySelectorAll('.pf-nav-link');

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              pfNavLinks.forEach((link) => {
                link.classList.toggle(
                  'pf-nav-link--active',
                  link.getAttribute('href') === '#' + entry.target.id
                );
              });
            }
          });
        },
        { rootMargin: '-40% 0px -55% 0px' }
      );
      pfSections.forEach((s) => sectionObserver.observe(s));
    </script>

  </body>
</html>

<style>
  /* ── LAYOUT ── */
  #pf-main { padding-top: 64px; /* clear fixed site header */ }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 60px;
  }

  /* ── PORTFOLIO SUB-NAV ── */
  .pf-nav {
    position: sticky;
    top: 64px;
    z-index: 90;
    background: var(--color-nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .pf-nav-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 60px;
    display: flex;
    gap: 0;
  }

  .pf-nav-link {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    padding: 14px 16px;
    position: relative;
    transition: color 0.2s;
  }

  .pf-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 16px; right: 16px;
    height: 2px;
    background: var(--color-terracotta);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .pf-nav-link:hover { color: var(--color-ink); }
  .pf-nav-link--active { color: var(--color-terracotta); }
  .pf-nav-link--active::after { transform: scaleX(1); }

  /* ── SECTIONS ── */
  .pf-section { padding: 80px 0; }

